/// Tickets de la mesa MDSC (todo el histórico, sin tickets en Cerrada; incluye Emailed request). Búsqueda ligera con solo los campos usados; el historial de estado y responsable se pide en bloque y solo lo calculan FactStatusHistory y FactAssigneeHistory. No se carga al modelo.
expression Jira_MDSC_Issues =
		let
		
		    // ========================================
		    // CONFIGURACIÓN
		    // ========================================
		
		    JiraBaseUrl = "https://secureopsmx.atlassian.net",
		    // Todo el histórico de la mesa, sin los tickets cuyo estado actual es Cerrada (en JQL: Closed)
		    JQL = "project = MDSC AND status != Closed ORDER BY created DESC",
		
		    // Tamaño de página de la búsqueda: Jira entrega como máximo 100 tickets por página con estos campos (medido)
		    PageSize = "100",
		    // Tickets por llamada al historial en bloque (máximo de Jira: 1000)
		    BulkSize = 1000,
		    // Solo interesan los cambios de estado y de responsable
		    CampoHistorial = {"status", "assignee"},
		
		
		    // ========================================
		    // CAMPOS
		    // ========================================
		
		    // "tipo de ticket" (radio buttons) se busca por nombre para no fijar su ID
		    AllFields =
		        Json.Document(
		            Web.Contents(
		                JiraBaseUrl,
		                [
		                    RelativePath = "rest/api/3/field",
		                    Headers = [Accept = "application/json"]
		                ]
		            )
		        ),
		
		    TipoTicketMatches =
		        List.Select(
		            AllFields,
		            each
		                Text.Lower(Text.Trim([name])) = "tipo de ticket"
		                and Text.Contains(
		                    Text.From(Record.FieldOrDefault(Record.FieldOrDefault(_, "schema", []), "custom", "")),
		                    "radiobuttons"
		                )
		        ),
		
		    TipoTicketFieldId =
		        if List.IsEmpty(TipoTicketMatches) then null else TipoTicketMatches{0}[id],
		
		
		    // Solo los campos que usa el modelo:
		    // customfield_10010 = Request Type
		    // customfield_10936 = Tiempo hasta primera respuesta (SLA JSM)
		    // customfield_10937 = Tiempo hasta resolución (SLA JSM)
		    // customfield_11042 = Técnico(s) asignado(s)
		    // customfield_10002 = Organizations (cliente)
		    // customfield_11469 = AQL N1 (auditoría de calidad N1: Correcto / Incorrecto)
		    // customfield_11470 = AQL N2 (auditoría de calidad N2: Correcto / Incorrecto)
		    BaseFields = {
		        "summary", "status", "issuetype", "assignee", "created", "resolutiondate",
		        "customfield_10010", "customfield_10936", "customfield_10937", "customfield_11042",
		        "customfield_10002", "customfield_11469", "customfield_11470"
		    },
		
		    JiraFields =
		        Text.Combine(
		            BaseFields & List.RemoveNulls({TipoTicketFieldId}),
		            ","
		        ),
		
		
		    // ========================================
		    // BÚSQUEDA PAGINADA (ligera: sin historial)
		    // ========================================
		
		    GetPage = (NextToken as nullable text, ConHistorial as logical, optional Campos as nullable text) as record =>
		        let
		            BaseQuery = [jql = JQL, maxResults = PageSize, fields = if Campos = null then JiraFields else Campos],
		            ConExpand = if ConHistorial then Record.AddField(BaseQuery, "expand", "changelog") else BaseQuery,
		            RequestQuery =
		                if NextToken = null
		                then ConExpand
		                else Record.AddField(ConExpand, "nextPageToken", NextToken)
		        in
		            Json.Document(
		                Web.Contents(
		                    JiraBaseUrl,
		                    [
		                        RelativePath = "rest/api/3/search/jql",
		                        Query = RequestQuery,
		                        Headers = [Accept = "application/json"]
		                    ]
		                )
		            ),
		
		    Search = (ConHistorial as logical, optional Campos as nullable text) as list =>
		        List.Combine(
		            List.Generate(
		                () => GetPage(null, ConHistorial, Campos),
		                each _ <> null,
		                each
		                    let
		                        Token = Record.FieldOrDefault(_, "nextPageToken", null)
		                    in
		                        if Token = null then null else GetPage(Token, ConHistorial, Campos),
		                each [issues]
		            )
		        ),
		
		    // List.Buffer: la lista se guarda en memoria y no se vuelve a pedir a Jira al recorrerla otra vez
		    RawIssues = List.Buffer(Search(false)),
		
		
		    // ========================================
		    // HISTORIAL EN BLOQUE (solo estado y responsable)
		    // ========================================
		
		    // POST /rest/api/3/changelog/bulkfetch: hasta 1000 tickets por llamada, filtrado por campo
		    BulkPage = (Ids as list, NextToken as nullable text) as record =>
		        let
		            Body0 = [issueIdsOrKeys = Ids, fieldIds = CampoHistorial, maxResults = 1000],
		            Body = if NextToken = null then Body0 else Record.AddField(Body0, "nextPageToken", NextToken)
		        in
		            Json.Document(
		                Web.Contents(
		                    JiraBaseUrl,
		                    [
		                        RelativePath = "rest/api/3/changelog/bulkfetch",
		                        Headers = [Accept = "application/json", #"Content-Type" = "application/json"],
		                        Content = Json.FromValue(Body)
		                    ]
		                )
		            ),
		
		    BulkLote = (Ids as list) as list =>
		        List.Combine(
		            List.Generate(
		                () => BulkPage(Ids, null),
		                each _ <> null,
		                each
		                    let
		                        Token = Record.FieldOrDefault(_, "nextPageToken", null)
		                    in
		                        if Token = null then null else BulkPage(Ids, Token),
		                each Record.FieldOrDefault(_, "issueChangeLogs", {})
		            )
		        ),
		
		    // Un registro {issueId: lista de cambios}; se arma una sola vez y solo si una tabla pide el historial
		    HistorialEnBloque =
		        let
		            Ids = List.Transform(RawIssues, each Text.From([id])),
		            Lotes = List.Split(Ids, BulkSize),
		            // POST no se guarda en caché: se buffer-ea para no repetir llamadas al recorrerlo
		            Logs = List.Buffer(List.Combine(List.Transform(Lotes, BulkLote))),
		            Agrupado =
		                Table.Buffer(Table.Group(
		                    Table.FromRecords(
		                        List.Transform(
		                            Logs,
		                            each [IssueId = Text.From([issueId]), Cambios = Record.FieldOrDefault(_, "changeHistories", {})]
		                        ),
		                        type table [IssueId = text, Cambios = list]
		                    ),
		                    {"IssueId"},
		                    {{"Cambios", each List.Combine([Cambios]), type list}}
		                ))
		        in
		            Record.FromList(Agrupado[Cambios], Agrupado[IssueId]),
		
		    // Si el historial en bloque no está disponible, se usa el método anterior (búsqueda con historial)
		    HistorialAnterior =
		        let
		            ConHistorial = List.Buffer(Search(true)),
		            GetChangelogPage = (IssueKey as text, StartAt as number) as record =>
		                Json.Document(
		                    Web.Contents(
		                        JiraBaseUrl,
		                        [
		                            RelativePath = "rest/api/3/issue/" & IssueKey & "/changelog",
		                            Query = [startAt = Text.From(StartAt), maxResults = "100"],
		                            Headers = [Accept = "application/json"]
		                        ]
		                    )
		                ),
		            GetFullChangelog = (IssueKey as text) as list =>
		                List.Combine(
		                    List.Generate(
		                        () => GetChangelogPage(IssueKey, 0),
		                        each _ <> null,
		                        each
		                            let
		                                Next = [startAt] + List.Count([values])
		                            in
		                                if List.IsEmpty([values]) or Next >= [total]
		                                then null
		                                else GetChangelogPage(IssueKey, Next),
		                        each [values]
		                    )
		                ),
		            Completo = (Issue as record) as list =>
		                let
		                    Changelog = Record.FieldOrDefault(Issue, "changelog", null),
		                    Embedded = if Changelog = null then null else Record.FieldOrDefault(Changelog, "histories", null),
		                    IsComplete = Embedded <> null and List.Count(Embedded) >= Record.FieldOrDefault(Changelog, "total", 0)
		                in
		                    if IsComplete then Embedded else GetFullChangelog(Issue[key])
		        in
		            Record.FromList(
		                List.Transform(ConHistorial, Completo),
		                List.Transform(ConHistorial, each Text.From([id]))
		            ),
		
		    Historial = try HistorialEnBloque otherwise HistorialAnterior,
		
		
		    // ========================================
		    // PRIMER COMENTARIO (primera respuesta)
		    // ========================================
		
		    // Una búsqueda más, solo con comentarios y quien levantó el ticket (100 tickets por página, no una llamada por ticket).
		    // Primera respuesta = el comentario más antiguo de alguien distinto a quien levantó el ticket.
		    // Se calcula solo si una tabla lo pide (SLA_Tickets).
		    PrimerComentario =
		        let
		            ConComentarios = List.Buffer(Search(false, "comment,reporter")),
		            Primero = (i as record) as nullable text =>
		                let
		                    f = i[fields],
		                    Reporter = Record.FieldOrDefault(Record.FieldOrDefault(f, "reporter", []) ?? [], "accountId", null),
		                    Lista = Record.FieldOrDefault(Record.FieldOrDefault(f, "comment", []) ?? [], "comments", {}),
		                    DeOtros =
		                        List.Select(
		                            Lista,
		                            each Record.FieldOrDefault(Record.FieldOrDefault(_, "author", []) ?? [], "accountId", null) <> Reporter
		                        ),
		                    // todas las fechas vienen con la misma zona horaria: el orden de texto es el orden cronológico
		                    Fechas = List.Sort(List.Transform(DeOtros, each [created]))
		                in
		                    if List.IsEmpty(Fechas) then null else Fechas{0}
		        in
		            Record.FromList(
		                List.Transform(ConComentarios, Primero),
		                List.Transform(ConComentarios, each Text.From([id]))
		            ),
		
		
		    // ========================================
		    // RESULTADO
		    // ========================================
		
		    // "histories" se evalúa solo cuando una tabla lo usa (FactStatusHistory y FactAssigneeHistory);
		    // SLA_Tickets y FactTecnicos solo hacen la búsqueda ligera.
		    Issues =
		        List.Transform(
		            RawIssues,
		            each [
		                id = [id],
		                key = [key],
		                fields = [fields],
		                tipoTicketFieldId = TipoTicketFieldId,
		                histories = Record.FieldOrDefault(Historial, Text.From([id]), {}),
		                primerComentario = Record.FieldOrDefault(PrimerComentario, Text.From([id]), null)
		            ]
		        )
		
		in
		    Issues
	lineageTag: 3f6a1c52-8d4e-4b7a-9e21-6c0d5b8a7f13

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = List

/// Horas laborales entre dos fechas según el calendario operativo de RAM: lunes a viernes 7:00-23:00, sábado y domingo 8:00-18:00.
/// Para cambiar el horario, editar la función Ventana.
expression HorasLaborales =
		(Inicio as nullable datetime, Fin as nullable datetime) as number =>
		    if Inicio = null or Fin = null or Fin <= Inicio then 0
		    else
		        let
		            // Horas de inicio y fin de cada día (Date.DayOfWeek con lunes = 0)
		            Ventana = (Dia as date) as nullable list =>
		                let
		                    DiaSemana = Date.DayOfWeek(Dia, Day.Monday)
		                in
		                    if DiaSemana <= 4 then {7, 23}
		                    else {8, 18},
		
		            // Horas laborales de una semana completa: 5 x 16 h + 10 h del sábado + 10 h del domingo
		            HorasSemana = 100,
		
		            HorasEnDia = (Dia as date, Desde as datetime, Hasta as datetime) as number =>
		                let
		                    W = Ventana(Dia)
		                in
		                    if W = null then 0
		                    else
		                        let
		                            Abre = Dia & #time(W{0}, 0, 0),
		                            Cierra = Dia & #time(W{1}, 0, 0),
		                            D = if Desde > Abre then Desde else Abre,
		                            H = if Hasta < Cierra then Hasta else Cierra
		                        in
		                            if H > D then Duration.TotalHours(H - D) else 0,
		
		            Dia1 = Date.From(Inicio),
		            DiaN = Date.From(Fin),
		            TotalDias = Duration.Days(DiaN - Dia1) + 1
		        in
		            if TotalDias <= 14 then
		                // Tramo corto: día por día
		                List.Sum(
		                    List.Transform(
		                        List.Dates(Dia1, TotalDias, #duration(1, 0, 0, 0)),
		                        (Dia) => HorasEnDia(Dia, Inicio, Fin)
		                    )
		                )
		            else
		                // Tramo largo: primer y último día parciales + semanas completas + días sueltos
		                let
		                    Intermedios = TotalDias - 2,
		                    Semanas = Number.IntegerDivide(Intermedios, 7),
		                    Sueltos = Number.Mod(Intermedios, 7),
		                    DiasSueltos = List.Dates(Date.AddDays(Dia1, 1 + Semanas * 7), Sueltos, #duration(1, 0, 0, 0)),
		                    HorasSueltos =
		                        List.Sum(
		                            List.Transform(
		                                DiasSueltos,
		                                (Dia) => HorasEnDia(Dia, Dia & #time(0, 0, 0), Date.AddDays(Dia, 1) & #time(0, 0, 0))
		                            )
		                        )
		                in
		                    HorasEnDia(Dia1, Inicio, Date.AddDays(Dia1, 1) & #time(0, 0, 0))
		                        + Semanas * HorasSemana
		                        + (if HorasSueltos = null then 0 else HorasSueltos)
		                        + HorasEnDia(DiaN, DiaN & #time(0, 0, 0), Fin)
	lineageTag: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d

	annotation PBI_ResultType = Function

/// Catálogo de técnicos por nivel de atención (páginas Calidad del servicio N1 y Métricas de N2). No se carga al modelo.
/// Identificación: "Assignee" = se mide por el responsable del ticket (en cualquier momento, según el historial);
/// "Técnicos asignados" = se mide por el campo Técnico(s) asignado(s) (customfield_11042).
/// El cruce con Jira ignora mayúsculas, acentos, espacios y guiones bajos, y también acepta la cuenta y los alias.
/// Para cambiar a alguien de nivel o agregar un técnico, editar solo esta tabla.
expression Tecnicos_Nivel =
		let
		    Fuente =
		        #table(
		            type table [#"Técnico" = text, Cuenta = text, Nivel = text, #"Identificación" = text, Alias = list],
		            {
		                // N1: se mide por Assignee (responsable del ticket en algún momento)
		                {"Antonyo Angel Herrera Herrera", "aherrera@redesmayab.com", "N1", "Assignee", {"Antonyo Herrera"}},
		                {"Wilberth de Jesús Cuytun Hernández", "wcuytun@redesmayab.com", "N1", "Assignee", {"Wilberth Cuytun"}},
		                {"Josué Alejandro Villafaña Herrera", "jvillafana@redesmayab.com", "N1", "Assignee", {"Josué Villafaña"}},
		                {"Elias Canseco Garcia", "ecanseco@redesmayab.com", "N1", "Assignee", {"Elias Canseco"}},
		
		                // N2, grupo 1: se mide por Assignee (incluye las cuentas de equipo de campo)
		                {"Dennis Emmanuel Zavala Avila", "dzavala@redesmayab.com", "N2", "Assignee", {}},
		                {"Diego Aguilar", "daguilar@redesmayab.com", "N2", "Assignee", {}},
		                {"Saúl Gutiérrez Vázquez", "sgutierrez@redesmayab.com", "N2", "Assignee", {"Saúl Gutiérrez"}},
		                {"José Javier Fuentes Cruz", "jfuentes@redesmayab.com", "N2", "Assignee", {}},
		                {"Victor Manuel Dzul de la Peña", "vdzul@redesmayab.com", "N2", "Assignee", {}},
		                {"Manuel de Jesus Ku Canul", "tecnicoredes@redesmayab.com", "N2", "Assignee", {}},
		                {"Servicios Equipo 1", "servicios_equipo1@redesmayab.com", "N2", "Assignee", {"Servicios_Equipo1", "Servicios Equipo1"}},
		                {"Servicios Equipo 2", "servicios_equipo2@redesmayab.com", "N2", "Assignee", {"Servicios_Equipo2", "Servicios Equipo2"}},
		                {"Servicios Equipo 3", "servicios_equipo3@redesmayab.com", "N2", "Assignee", {"Servicios_Equipo3", "Servicios Equipo3", "servicio_equipo3"}},
		                // Agregado a N2 el 08/11/2026 (responsable de tickets en Jira; cuenta de correo por confirmar)
		                {"Ricardo Alvarado", "", "N2", "Assignee", {}},
		
		                // N2, grupo 2: se mide por el campo "Técnico(s) asignado(s)" (customfield_11042)
		                {"Angel Amiel Rodriguez Lopez", "alopez@redesmayab.com", "N2", "Técnicos asignados", {}},
		                {"Rodolfo Ramírez Ramos", "rramirez@redesmayab.com", "N2", "Técnicos asignados", {}},
		                {"Esner Augusto Cel Cardenas", "ecel@redesmayab.com", "N2", "Técnicos asignados", {}},
		                {"Manuel de Jesus Ku Canul", "tecnicoredes@redesmayab.com", "N2", "Técnicos asignados", {}},
		                {"Fabian jesus Figueroa fuentes", "ffigueroa@redesmayab.com", "N2", "Técnicos asignados", {}},
		                {"Josafat Alexander Cel Cardenas", "jcel@redesmayab.com", "N2", "Técnicos asignados", {}}
		            }
		        )
		in
		    Fuente
	lineageTag: 692f6baf-1036-4ebf-80dc-161762da2be9


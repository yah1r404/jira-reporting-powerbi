table _Medidas
	lineageTag: 0cdf12bc-8e55-4227-a993-f259e17d333d

	/// Tickets de la mesa MDSC en el contexto actual.
	measure Tickets = COUNTROWS(SLA_Tickets)
		formatString: #,##0
		displayFolder: SLA
		lineageTag: 3223c518-f5d7-4ab3-a344-09d51d8ea303

	/// Tickets con fecha de resolución.
	measure 'Tickets Resueltos' = CALCULATE([Tickets], NOT ISBLANK(SLA_Tickets[Resolution Date]))
		formatString: #,##0
		displayFolder: SLA
		lineageTag: 737c2adf-b541-439e-bdaa-c624d8f13550

	/// Tickets sin fecha de resolución.
	measure 'Tickets Abiertos' = [Tickets] - [Tickets Resueltos]
		formatString: #,##0
		displayFolder: SLA
		lineageTag: 231f3a65-a547-48f2-af53-67626259ada1

	/// Tickets que cumplieron el SLA "Tiempo hasta resolución" de JSM.
	measure 'SLA Resolución Cumplidos' = CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado] = "Cumplido")
		formatString: #,##0
		displayFolder: SLA\Resolución
		lineageTag: 12bc689e-fbfc-41a2-bd72-7a192f75d8b5

	/// Tickets que incumplieron el SLA de resolución (incluye abiertos ya vencidos).
	measure 'SLA Resolución Incumplidos' = CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado] = "Incumplido")
		formatString: #,##0
		displayFolder: SLA\Resolución
		lineageTag: 3ca773cd-6f18-43fb-b2cb-837ec06dc714

	/// Tickets abiertos con 25% o menos del tiempo de SLA de resolución restante.
	measure 'SLA Resolución En Riesgo' = CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado] = "En riesgo")
		formatString: #,##0
		displayFolder: SLA\Resolución
		lineageTag: 156bc5fa-eed3-43cd-be95-0dafcbf1e244

	/// Cumplidos / (Cumplidos + Incumplidos). No cuenta tickets en curso ni sin SLA.
	measure '% SLA Resolución' = DIVIDE([SLA Resolución Cumplidos], [SLA Resolución Cumplidos] + [SLA Resolución Incumplidos])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA\Resolución
		lineageTag: 2ef20b9c-b948-40c2-b13c-658a43a688dd

	/// Promedio del tiempo de SLA de resolución medido por JSM (respeta pausas y calendario del SLA).
	measure 'Prom Horas SLA Resolución' = AVERAGE(SLA_Tickets[SLA Resolución Horas])
		formatString: #,##0.00
		displayFolder: SLA\Resolución
		lineageTag: fe47d848-4205-42b9-9356-ef8afc5191ee

	/// Tickets que cumplieron el SLA "Tiempo hasta primera respuesta" de JSM.
	measure 'SLA Respuesta Cumplidos' = CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado] = "Cumplido")
		formatString: #,##0
		displayFolder: SLA\Primera Respuesta
		lineageTag: dc9f86d7-6653-446b-bc68-cbec71744d28

	/// Tickets que incumplieron el SLA de primera respuesta (incluye abiertos ya vencidos).
	measure 'SLA Respuesta Incumplidos' = CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado] = "Incumplido")
		formatString: #,##0
		displayFolder: SLA\Primera Respuesta
		lineageTag: e6021d46-e528-422e-a6a0-eaddaaf9da33

	/// Cumplidos / (Cumplidos + Incumplidos) del SLA de primera respuesta.
	measure '% SLA Primera Respuesta' = DIVIDE([SLA Respuesta Cumplidos], [SLA Respuesta Cumplidos] + [SLA Respuesta Incumplidos])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA\Primera Respuesta
		lineageTag: 9033ff50-fa3a-4c56-bebe-aae0c4a48f20

	/// Promedio del tiempo de SLA de primera respuesta medido por JSM.
	measure 'Prom Horas SLA Respuesta' = AVERAGE(SLA_Tickets[SLA Respuesta Horas])
		formatString: #,##0.00
		displayFolder: SLA\Primera Respuesta
		lineageTag: 4a1d7c0e-6b2f-4e8a-9d13-5c7f0b9e2a61

	/// Promedio de horas CALENDARIO entre creación y resolución (no es el tiempo de SLA).
	measure 'Prom Horas Resolución Calendario' = AVERAGE(SLA_Tickets[Resolution Hours])
		formatString: #,##0.00
		displayFolder: SLA\Calendario
		lineageTag: 5b2e8d1f-7c30-4f9b-8e24-6d80c1af3b72

	/// Mediana de horas calendario entre creación y resolución.
	measure 'Mediana Horas Resolución Calendario' = MEDIAN(SLA_Tickets[Resolution Hours])
		formatString: #,##0.00
		displayFolder: SLA\Calendario
		lineageTag: 6c3f9e20-8d41-4a0c-9f35-7e91d2b04c83

	/// Percentil 90 de horas calendario entre creación y resolución.
	measure 'P90 Horas Resolución Calendario' = PERCENTILEX.INC(SLA_Tickets, SLA_Tickets[Resolution Hours], 0.90)
		formatString: #,##0.00
		displayFolder: SLA\Calendario
		lineageTag: 7d40af31-9e52-4b1d-8a46-8fa2e3c15d94

	/// Horas totales en estados no finales (excluye Resuelta/Cerrada).
	measure 'Horas en Estado' = CALCULATE([Suma Horas Estado], FactStatusHistory[Es Estado Final] = FALSE())
		formatString: #,##0.00
		displayFolder: Time in Status
		lineageTag: 8e51b042-af63-4c2e-9b57-90b3f4d26ea5

	/// Tickets que pasaron por el estado (estados no finales).
	measure 'Tickets en Estado' = CALCULATE(DISTINCTCOUNT(FactStatusHistory[Key]), FactStatusHistory[Es Estado Final] = FALSE())
		formatString: #,##0
		displayFolder: Time in Status
		lineageTag: 9f62c153-b074-4d3f-8c68-a1c4f5e37fb6

	/// Horas promedio que un ticket pasa en el estado (suma todas sus visitas al estado).
	measure 'Prom Horas en Estado' = DIVIDE([Horas en Estado], [Tickets en Estado])
		formatString: #,##0.00
		displayFolder: Time in Status
		lineageTag: a073d264-c185-4e40-8d79-b2d5a6f48a07

	/// Mediana por ticket de las horas en el estado.
	measure 'Mediana Horas en Estado' =
			CALCULATE(
			    MEDIANX(VALUES(FactStatusHistory[Key]), CALCULATE([Suma Horas Estado])),
			    FactStatusHistory[Es Estado Final] = FALSE()
			)
		formatString: #,##0.00
		displayFolder: Time in Status
		lineageTag: b184e375-d296-4f51-8e8a-c3e5b7a59b18

	/// Percentil 90 por ticket de las horas en el estado.
	measure 'P90 Horas en Estado' =
			CALCULATE(
			    PERCENTILEX.INC(VALUES(FactStatusHistory[Key]), CALCULATE([Suma Horas Estado]), 0.90),
			    FactStatusHistory[Es Estado Final] = FALSE()
			)
		formatString: #,##0.00
		displayFolder: Time in Status
		lineageTag: c295f486-e3a7-4062-9f60-d4f6c86a6c29

	/// Horas que las personas tuvieron asignados tickets ya resueltos, hasta su resolución. Excluye "Sin asignar" y tickets abiertos.
	measure 'Horas Asignado' =
			CALCULATE(
			    [Suma Horas Asignado],
			    FactAssigneeHistory[Ticket Resuelto] = TRUE(),
			    KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar")
			)
		formatString: #,##0.00
		displayFolder: Time in Assignee
		lineageTag: d3a60597-f4b8-4173-a071-e5a7e7b97d3a

	/// Tickets resueltos que la persona tuvo asignados en algún momento.
	measure 'Tickets Atendidos' =
			CALCULATE(
			    DISTINCTCOUNT(FactAssigneeHistory[Key]),
			    FactAssigneeHistory[Ticket Resuelto] = TRUE(),
			    KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar")
			)
		formatString: #,##0
		displayFolder: Time in Assignee
		lineageTag: e4b716a8-05c9-4284-b182-f6b8f8c08e4b

	/// Horas promedio que un ticket resuelto estuvo asignado a la persona durante su vida (de la creación a la resolución).
	measure 'Prom Horas Asignado por Ticket' = DIVIDE([Horas Asignado], [Tickets Atendidos])
		formatString: #,##0.00
		displayFolder: Time in Assignee
		lineageTag: f5c827b9-16da-4395-8c39-07c9d9019f5c

	/// Mediana por ticket de las horas asignado a la persona (tickets resueltos, sin "Sin asignar"). Menos sensible a casos extremos que el promedio.
	measure 'Mediana Horas Asignado' =
			CALCULATE(
			    MEDIANX(VALUES(FactAssigneeHistory[Key]), CALCULATE([Suma Horas Asignado])),
			    FactAssigneeHistory[Ticket Resuelto] = TRUE(),
			    KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar")
			)
		formatString: #,##0.00
		displayFolder: Time in Assignee
		lineageTag: 06d938ca-27eb-44a6-9d4a-18c9fa1a0a6d

	/// Cambios de responsable en los tickets del contexto.
	measure 'Total Reasignaciones' = SUM(SLA_Tickets[Reasignaciones])
		formatString: #,##0
		displayFolder: Time in Assignee
		lineageTag: 17ea49db-38eb-4b5f-ae4b-29da1b2b1b7e

	/// % SLA de resolución de los tickets que la persona tuvo asignados en algún momento.
	measure '% SLA Resolución Tickets Atendidos' =
			CALCULATE(
			    [% SLA Resolución],
			    TREATAS(VALUES(FactAssigneeHistory[Key]), SLA_Tickets[Key])
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time in Assignee
		lineageTag: 28fb5aec-49ec-4c6c-bf28-3a2c3c3c2c8f

	/// Meta de cumplimiento de SLA usada por el semáforo (verde desde aquí). Ajustar al acuerdo de servicio.
	measure 'Meta % SLA' = 0.95
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA\Semáforo
		lineageTag: 39a1c2d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d

	/// Umbral de alerta del semáforo (amarillo desde aquí, rojo por debajo). Ajustar al acuerdo de servicio.
	measure 'Umbral Alerta % SLA' = 0.85
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA\Semáforo
		lineageTag: 4ab2d3e5-6f70-4b8c-9dae-1f203b4c5d6e

	/// Color de semáforo para % SLA Resolución: azul (neutro) >= meta, ámbar >= umbral, rojo debajo.
	measure 'Color % SLA Resolución' =
			VAR v = [% SLA Resolución]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), "#8A97A8",
			        v >= [Meta % SLA], "#06519A",
			        v >= [Umbral Alerta % SLA], "#C98A00",
			        "#C8382E"
			    )
		displayFolder: SLA\Semáforo
		lineageTag: 5bc3e4f6-7081-4c9d-aebf-203a4c5d6e7f

	/// Color de semáforo para % SLA Primera Respuesta.
	measure 'Color % SLA Primera Respuesta' =
			VAR v = [% SLA Primera Respuesta]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), "#8A97A8",
			        v >= [Meta % SLA], "#06519A",
			        v >= [Umbral Alerta % SLA], "#C98A00",
			        "#C8382E"
			    )
		displayFolder: SLA\Semáforo
		lineageTag: 6cd4f507-8192-4dae-bfc0-314b5d6e7f80

	/// Fecha y hora del último refresh de los datos de Jira (hora de Mérida).
	measure 'Última Actualización' = CALCULATE(MAX(FactStatusHistory[Fin]), REMOVEFILTERS())
		formatString: dd/mm/yyyy hh:nn
		displayFolder: SLA
		lineageTag: 7de50618-92a3-4ebf-80d1-425c6e7f8091

	/// Horas del SLA objetivo elegido en el filtro. En blanco = meta en horas de cada ticket.
	measure 'Meta SLA Seleccionada' =
			VAR Sel = SELECTEDVALUE('SLA Objetivo'[Horas])
			RETURN IF(Sel > 0, Sel)
		formatString: 0.## "hrs"
		displayFolder: SLA Seleccionado
		lineageTag: 4f708192-a3b4-4ec5-9f60-718293a4b5c6

	/// Horas de la meta aplicada: las del SLA objetivo elegido o, si no se eligió, las metas de los tickets (ej. 15 h / 24 h).
	measure 'Meta SLA Aplicada' =
			VAR Meta = [Meta SLA Seleccionada]
			RETURN
			    IF(
			        ISBLANK(Meta),
			        CONCATENATEX(
			            FILTER(VALUES(SLA_Tickets[SLA Resolución Meta Horas]), NOT ISBLANK(SLA_Tickets[SLA Resolución Meta Horas])),
			            FORMAT(SLA_Tickets[SLA Resolución Meta Horas], "0.##") & " h",
			            " / ", SLA_Tickets[SLA Resolución Meta Horas], ASC
			        ),
			        FORMAT(Meta, "0.##") & " h"
			    )
		displayFolder: SLA Seleccionado
		lineageTag: 508192a3-b4c5-4fd6-8071-8293a4b5c6d7

	/// Tickets que cumplen. Sin SLA objetivo elegido: los "Cumplido" del SLA de Jira (igual que el resto del tablero).
	/// Con una meta del cliente: tickets resueltos cuyas horas de SLA no pasan esa meta.
	measure 'Cumplen SLA Seleccionado' =
			VAR MetaSel = [Meta SLA Seleccionada]
			RETURN
			    IF(
			        ISBLANK(MetaSel),
			        [SLA Resolución Cumplidos],
			        COUNTROWS(
			            FILTER(
			                SLA_Tickets,
			                NOT ISBLANK(SLA_Tickets[Resolution Date])
			                    && NOT ISBLANK(SLA_Tickets[Horas SLA Base])
			                    && SLA_Tickets[Horas SLA Base] <= MetaSel
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: SLA Seleccionado
		lineageTag: 6192a3b4-c5d6-40e7-9182-93a4b5c6d7e8

	/// Tickets que no cumplen. Sin SLA objetivo elegido: los "Incumplido" del SLA de Jira (igual que el resto del tablero).
	/// Con una meta del cliente: tickets (resueltos o abiertos) cuyas horas de SLA pasan esa meta.
	measure 'Incumplen SLA Seleccionado' =
			VAR MetaSel = [Meta SLA Seleccionada]
			VAR T =
			    ADDCOLUMNS(
			        SLA_Tickets,
			        "@Meta", IF(ISBLANK(MetaSel), SLA_Tickets[SLA Resolución Meta Horas], MetaSel),
			        "@Horas", SLA_Tickets[Horas SLA Base],
			        "@Inc",
			            IF(
			                ISBLANK(MetaSel),
			                SLA_Tickets[SLA Resolución Estado] = "Incumplido",
			                NOT ISBLANK(SLA_Tickets[Horas SLA Base]) && SLA_Tickets[Horas SLA Base] > MetaSel
			            )
			    )
			RETURN COUNTROWS(FILTER(T, [@Inc]))
		formatString: #,##0
		displayFolder: SLA Seleccionado
		lineageTag: 72a3b4c5-d6e7-41f8-a293-a4b5c6d7e8f9

	/// Tickets evaluados contra el SLA objetivo (cumplen + incumplen). No cuenta abiertos dentro de tiempo.
	measure 'Evaluados SLA Seleccionado' = [Cumplen SLA Seleccionado] + [Incumplen SLA Seleccionado]
		formatString: #,##0
		displayFolder: SLA Seleccionado
		lineageTag: 83b4c5d6-e7f8-4209-b3a4-b5c6d7e8f90a

	/// % de cumplimiento contra el SLA objetivo elegido.
	measure '% SLA Seleccionado' = DIVIDE([Cumplen SLA Seleccionado], [Evaluados SLA Seleccionado])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA Seleccionado
		lineageTag: 94c5d6e7-f809-431a-84b5-c6d7e8f90a1b

	/// Color de semáforo para % SLA Seleccionado.
	measure 'Color % SLA Seleccionado' =
			VAR v = [% SLA Seleccionado]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), "#8A97A8",
			        v >= [Meta % SLA], "#06519A",
			        v >= [Umbral Alerta % SLA], "#C98A00",
			        "#C8382E"
			    )
		displayFolder: SLA Seleccionado
		lineageTag: a5d6e7f8-091a-442b-95c6-d7e8f90a1b2c

	/// Horas de SLA del ticket, solo si no cumplió (en blanco si cumplió). Sirve para listar los incumplidos.
	measure 'Horas Ticket Incumplido' =
			VAR MetaSel = [Meta SLA Seleccionada]
			VAR T =
			    ADDCOLUMNS(
			        SLA_Tickets,
			        "@Meta", IF(ISBLANK(MetaSel), SLA_Tickets[SLA Resolución Meta Horas], MetaSel),
			        "@Horas", SLA_Tickets[Horas SLA Base],
			        "@Inc",
			            IF(
			                ISBLANK(MetaSel),
			                SLA_Tickets[SLA Resolución Estado] = "Incumplido",
			                NOT ISBLANK(SLA_Tickets[Horas SLA Base]) && SLA_Tickets[Horas SLA Base] > MetaSel
			            )
			    )
			RETURN SUMX(FILTER(T, [@Inc]), [@Horas])
		formatString: #,##0.00
		displayFolder: SLA Seleccionado
		lineageTag: b6e7f809-1a2b-453c-a6d7-e8f90a1b2c3d

	/// Meta en horas que se le aplicó al ticket que no cumplió (en blanco si cumplió).
	measure 'Meta Ticket Incumplido' =
			VAR MetaSel = [Meta SLA Seleccionada]
			VAR T =
			    ADDCOLUMNS(
			        SLA_Tickets,
			        "@Meta", IF(ISBLANK(MetaSel), SLA_Tickets[SLA Resolución Meta Horas], MetaSel),
			        "@Horas", SLA_Tickets[Horas SLA Base],
			        "@Inc",
			            IF(
			                ISBLANK(MetaSel),
			                SLA_Tickets[SLA Resolución Estado] = "Incumplido",
			                NOT ISBLANK(SLA_Tickets[Horas SLA Base]) && SLA_Tickets[Horas SLA Base] > MetaSel
			            )
			    )
			RETURN MAXX(FILTER(T, [@Inc]), [@Meta])
		formatString: #,##0.00
		displayFolder: SLA Seleccionado
		lineageTag: c7f8091a-2b3c-464d-b7e8-f90a1b2c3d4e

	/// Horas por encima de la meta en los tickets que no cumplieron.
	measure 'Horas Excedidas SLA' =
			VAR MetaSel = [Meta SLA Seleccionada]
			VAR T =
			    ADDCOLUMNS(
			        SLA_Tickets,
			        "@Meta", IF(ISBLANK(MetaSel), SLA_Tickets[SLA Resolución Meta Horas], MetaSel),
			        "@Horas", SLA_Tickets[Horas SLA Base],
			        "@Inc",
			            IF(
			                ISBLANK(MetaSel),
			                SLA_Tickets[SLA Resolución Estado] = "Incumplido",
			                NOT ISBLANK(SLA_Tickets[Horas SLA Base]) && SLA_Tickets[Horas SLA Base] > MetaSel
			            )
			    )
			VAR Exceso = SUMX(FILTER(T, [@Inc]), MAX(0, [@Horas] - [@Meta]))
			RETURN IF(Exceso > 0, Exceso)
		formatString: #,##0.00
		displayFolder: SLA Seleccionado
		lineageTag: d8091a2b-3c4d-475e-88f9-0a1b2c3d4e5f

	/// Horas en cada estado, solo de los tickets que incumplieron el SLA objetivo. Muestra dónde se fue el tiempo.
	measure 'Horas en Estado Incumplidos' =
			SUMX(
			    FILTER(VALUES(SLA_Tickets[Key]), [Incumplen SLA Seleccionado] > 0),
			    [Horas en Estado]
			)
		formatString: #,##0.00
		displayFolder: SLA Seleccionado
		lineageTag: e91a2b3c-4d5e-486f-99a0-1b2c3d4e5f60

	/// Promedio de personas distintas que atendieron cada ticket resuelto.
	measure 'Personas por Ticket' =
			CALCULATE(
			    AVERAGEX(VALUES(FactAssigneeHistory[Key]), CALCULATE(DISTINCTCOUNT(FactAssigneeHistory[Responsable]))),
			    FactAssigneeHistory[Ticket Resuelto] = TRUE(),
			    FactAssigneeHistory[Responsable] <> "Sin asignar"
			)
		formatString: #,##0.0
		displayFolder: Time in Assignee
		lineageTag: 45f60718-293a-44b5-8fc6-0718293a4b5c

	/// Horas promedio que los tickets resueltos pasaron sin responsable.
	measure 'Prom Horas Sin Asignar' =
			CALCULATE(
			    DIVIDE([Suma Horas Asignado], DISTINCTCOUNT(FactAssigneeHistory[Key])),
			    FactAssigneeHistory[Ticket Resuelto] = TRUE(),
			    FactAssigneeHistory[Responsable] = "Sin asignar"
			)
		formatString: #,##0.00
		displayFolder: Time in Assignee
		lineageTag: 5607182a-3a4b-45c6-80d7-18293a4b5c6d

	/// Línea de tiempo: 1 si la persona tenía asignado el ticket durante esa hora desde su creación.
	measure 'Gantt Responsable' =
			VAR H = SELECTEDVALUE('Línea de Tiempo'[Hora])
			VAR Ultima = CALCULATE(MAX('Línea de Tiempo'[Hora]), ALL('Línea de Tiempo'))
			RETURN
			    IF(
			        NOT ISBLANK(H),
			        IF(
			            COUNTROWS(
			                FILTER(
			                    FactAssigneeHistory,
			                    FactAssigneeHistory[Hora Fin] > H
			                        && (H = Ultima || FactAssigneeHistory[Hora Inicio] < H + 1)
			                )
			            ) > 0,
			            1
			        )
			    )
		formatString: 0
		displayFolder: Línea de Tiempo
		lineageTag: 67182a3b-4b5c-46d7-91e8-293a4b5c6d7e

	/// Color de la celda de la línea de tiempo de responsables: azul con persona, gris sin asignar.
	measure 'Color Gantt Responsable' =
			IF(
			    NOT ISBLANK([Gantt Responsable]),
			    IF(SELECTEDVALUE(FactAssigneeHistory[Responsable]) = "Sin asignar", "#C9D3E0", "#06519A")
			)
		displayFolder: Línea de Tiempo
		lineageTag: 782a3b4c-5c6d-47e8-a2f9-3a4b5c6d7e8f

	/// Línea de tiempo: 1 si el ticket estaba en ese estado durante esa hora desde su creación. No incluye estados finales.
	measure 'Gantt Estado' =
			VAR H = SELECTEDVALUE('Línea de Tiempo'[Hora])
			VAR Ultima = CALCULATE(MAX('Línea de Tiempo'[Hora]), ALL('Línea de Tiempo'))
			RETURN
			    IF(
			        NOT ISBLANK(H),
			        IF(
			            COUNTROWS(
			                FILTER(
			                    FactStatusHistory,
			                    FactStatusHistory[Es Estado Final] = FALSE()
			                        && FactStatusHistory[Hora Fin] > H
			                        && (H = Ultima || FactStatusHistory[Hora Inicio] < H + 1)
			                )
			            ) > 0,
			            1
			        )
			    )
		formatString: 0
		displayFolder: Línea de Tiempo
		lineageTag: 893b4c5d-6d7e-48f9-b30a-4b5c6d7e8f90

	/// Color de la celda de la línea de tiempo de estados: amarillo en espera, azul en atención, gris por hacer.
	measure 'Color Gantt Estado' =
			VAR Estado = SELECTEDVALUE(FactStatusHistory[Estado])
			VAR Categoria = SELECTEDVALUE(FactStatusHistory[Categoría Estado])
			RETURN
			    IF(
			        NOT ISBLANK([Gantt Estado]),
			        SWITCH(
			            TRUE(),
			            CONTAINSSTRING(Estado, "Esperando"), "#F1D72C",
			            Categoria = "Por hacer", "#A9C3E6",
			            "#06519A"
			        )
			    )
		displayFolder: Línea de Tiempo
		lineageTag: 9a4c5d6e-7e8f-4901-840b-5c6d7e8f90a1

	/// Texto con los filtros aplicados en las páginas de la mesa MDSC (se muestra debajo de la barra de filtros).
	measure 'Filtros Activos' =
			VAR Periodo =
			    IF(
			        ISFILTERED(DimFecha[Date]),
			        "Periodo: " & FORMAT(MIN(DimFecha[Date]), "dd/mm/yyyy") & " – " & FORMAT(MAX(DimFecha[Date]), "dd/mm/yyyy")
			    )
			VAR Org =
			    IF(
			        ISFILTERED(SLA_Tickets[Organización]),
			        "Cliente: "
			            & IF(
			                COUNTROWS(VALUES(SLA_Tickets[Organización])) > 2,
			                COUNTROWS(VALUES(SLA_Tickets[Organización])) & " seleccionadas",
			                CONCATENATEX(VALUES(SLA_Tickets[Organización]), SLA_Tickets[Organización], ", ")
			            )
			    )
			VAR Flujo =
			    IF(
			        ISFILTERED(SLA_Tickets[Flujo]),
			        "Tipo de Servicio: " & CONCATENATEX(VALUES(SLA_Tickets[Flujo]), SLA_Tickets[Flujo], ", ")
			    )
			VAR RT =
			    IF(
			        ISFILTERED(SLA_Tickets[Request Type]),
			        "Tipo de Solicitud: "
			            & IF(
			                COUNTROWS(VALUES(SLA_Tickets[Request Type])) > 2,
			                COUNTROWS(VALUES(SLA_Tickets[Request Type])) & " seleccionados",
			                CONCATENATEX(VALUES(SLA_Tickets[Request Type]), SLA_Tickets[Request Type], ", ")
			            )
			    )
			VAR Tipo =
			    IF(
			        ISFILTERED(SLA_Tickets[Tipo de Ticket]),
			        "Tipo de ticket: " & CONCATENATEX(VALUES(SLA_Tickets[Tipo de Ticket]), SLA_Tickets[Tipo de Ticket], ", ")
			    )
			VAR EstadoSla =
			    IF(
			        ISFILTERED(SLA_Tickets[SLA Resolución Estado]),
			        "Estado SLA: " & CONCATENATEX(VALUES(SLA_Tickets[SLA Resolución Estado]), SLA_Tickets[SLA Resolución Estado], ", ")
			    )
			VAR EstadoActual =
			    IF(
			        ISFILTERED(SLA_Tickets[Status]),
			        "Estado actual: " & CONCATENATEX(VALUES(SLA_Tickets[Status]), SLA_Tickets[Status], ", ")
			    )
			VAR Resp =
			    IF(
			        ISFILTERED(SLA_Tickets[Assignee]),
			        "Responsable actual: "
			            & IF(
			                COUNTROWS(VALUES(SLA_Tickets[Assignee])) > 2,
			                COUNTROWS(VALUES(SLA_Tickets[Assignee])) & " seleccionados",
			                CONCATENATEX(VALUES(SLA_Tickets[Assignee]), SLA_Tickets[Assignee], ", ")
			            )
			    )
			VAR Horario = "Horas: " & IF([Usa Horario Laboral], "horario laboral (L-V 6-23, Sáb 9-19)", "24/7")
			VAR Partes = { Periodo, Org, Flujo, RT, Tipo, EstadoSla, EstadoActual, Resp, Horario }
			VAR Texto =
			    CONCATENATEX(FILTER(Partes, NOT ISBLANK([Value])), [Value], "   ·   ")
			RETURN
			    IF(
			        ISBLANK(Texto) || Texto = "",
			        "Filtros activos: ninguno (todos los tickets de MDSC de los últimos 6 meses)",
			        "Filtros activos:   " & Texto
			    )
		displayFolder: Filtros
		lineageTag: ad5e6f70-8192-4a3b-9c4d-5e6f708192a3

	/// Color de texto para el estado del SLA de resolución: rojo incumplido, ámbar en riesgo, azul cumplido.
	measure 'Color Estado SLA Resolución' =
			SWITCH(
			    SELECTEDVALUE(SLA_Tickets[SLA Resolución Estado]),
			    "Incumplido", "#C8382E",
			    "En riesgo", "#8A6100",
			    "Cumplido", "#06519A",
			    "En curso", "#2F76C2",
			    "#5B6B7F"
			)
		displayFolder: Colores
		lineageTag: cf708192-a3b4-4c5d-9e6f-708192a3b4c5

	/// Color de texto para el estado del SLA de primera respuesta.
	measure 'Color Estado SLA Respuesta' =
			SWITCH(
			    SELECTEDVALUE(SLA_Tickets[SLA Respuesta Estado]),
			    "Incumplido", "#C8382E",
			    "En riesgo", "#8A6100",
			    "Cumplido", "#06519A",
			    "En curso", "#2F76C2",
			    "#5B6B7F"
			)
		displayFolder: Colores
		lineageTag: d08192a3-b4c5-4d6e-8f70-8192a3b4c5d6

	/// Color de texto para valores que indican incumplimiento (siempre rojo).
	measure 'Color Alerta' = "#C8382E"
		displayFolder: Colores
		lineageTag: f2a3b4c5-d6e7-4f80-8192-a3b4c5d6e7f8

	/// TRUE si las horas se calculan en horario laboral (L-V 6:00-23:00, Sáb 9:00-19:00). Es el valor predeterminado.
	measure 'Usa Horario Laboral' = SELECTEDVALUE('Horario Cálculo'[Clave], "laboral") = "laboral"
		displayFolder: Horario
		lineageTag: 718293a4-b5c6-41d2-9d4e-6f708192a3b4

	/// Suma de horas en estado según el horario de cálculo (laboral o 24/7).
	measure 'Suma Horas Estado' = IF([Usa Horario Laboral], SUM(FactStatusHistory[Horas Hábiles]), SUM(FactStatusHistory[Horas]))
		formatString: #,##0.00
		isHidden
		displayFolder: Horario
		lineageTag: 8293a4b5-c6d7-42e3-8e5f-708192a3b4c5

	/// Suma de horas asignado según el horario de cálculo (laboral o 24/7).
	measure 'Suma Horas Asignado' = IF([Usa Horario Laboral], SUM(FactAssigneeHistory[Horas Hábiles]), SUM(FactAssigneeHistory[Horas]))
		formatString: #,##0.00
		isHidden
		displayFolder: Horario
		lineageTag: 93a4b5c6-d7e8-43f4-9f60-8192a3b4c5d6

	/// Tickets únicos con al menos un técnico de campo. Un ticket con varios técnicos cuenta una vez.
	measure 'Tickets escalados a N2' = DISTINCTCOUNT(FactTecnicos[Key])
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 0b1c2d3e-4f50-4a61-9b72-c3d4e5f60811

	/// Participaciones: cada par ticket × técnico. Un ticket con 3 técnicos suma 3.
	measure 'Total participaciones técnicos' = COUNTROWS(FactTecnicos)
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 1c2d3e4f-5061-4b72-8c83-d4e5f6081922

	/// Técnicos de campo distintos que participaron.
	measure 'Total técnicos activos' = DISTINCTCOUNT(FactTecnicos[Técnico])
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 2d3e4f50-6172-4c83-9d94-e5f608192a33

	/// Promedio de tickets en los que participa cada técnico.
	measure 'Tickets por Técnico' = DIVIDE([Total participaciones técnicos], [Total técnicos activos])
		formatString: #,##0.0
		displayFolder: Técnicos de Campo
		lineageTag: 3e4f5061-7283-4d94-8ea5-f608192a3b44

	/// Promedio de técnicos que participan en cada ticket.
	measure 'Técnicos por Ticket' = DIVIDE([Total participaciones técnicos], [Tickets escalados a N2])
		formatString: #,##0.0
		displayFolder: Técnicos de Campo
		lineageTag: 4f506172-8394-4ea5-9fb6-08192a3b4c55

	/// Tickets con técnico ya resueltos (tienen fecha de resolución).
	measure 'Tickets resueltos por técnicos' = CALCULATE([Tickets escalados a N2], NOT ISBLANK(SLA_Tickets[Resolution Date]))
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 5061728a-94a5-4fb6-80c7-192a3b4c5d66

	/// Tickets con técnico sin resolver que ya están en atención (categoría de estado "En curso").
	measure 'Tickets Técnico En Proceso' =
			CALCULATE(
			    [Tickets escalados a N2],
			    ISBLANK(SLA_Tickets[Resolution Date]),
			    SLA_Tickets[Status Category] <> "Por hacer"
			)
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 61728a9b-a5b6-40c7-91d8-2a3b4c5d6e77

	/// Tickets con técnico sin resolver que todavía no se atienden (categoría de estado "Por hacer").
	measure 'Tickets Técnico Abiertos' =
			CALCULATE(
			    [Tickets escalados a N2],
			    ISBLANK(SLA_Tickets[Resolution Date]),
			    SLA_Tickets[Status Category] = "Por hacer"
			)
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: 728a9bac-b6c7-41d8-a2e9-3b4c5d6e7f88

	/// % de los tickets con técnico en los que participó el técnico (o técnicos) del contexto.
	/// La suma por técnico puede pasar de 100% porque un ticket puede tener varios técnicos.
	measure '% Participación Técnico' =
			DIVIDE(
			    [Tickets escalados a N2],
			    CALCULATE([Tickets escalados a N2], REMOVEFILTERS(FactTecnicos[Técnico], FactTecnicos[Técnico Account ID]))
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Técnicos de Campo
		lineageTag: 8a9bacbd-c7d8-42e9-b3fa-4c5d6e7f8099

	/// % SLA de resolución (metas de Jira) de los tickets en los que participó el técnico.
	/// Se atribuye por participación, no por responsabilidad (el responsable es el Assignee).
	measure '% SLA Resolución Técnico' = CALCULATE([% SLA Resolución], TREATAS(VALUES(FactTecnicos[Key]), SLA_Tickets[Key]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Técnicos de Campo
		lineageTag: 9bacbdce-d8e9-43fa-84ab-5d6e7f8091aa

	/// Color de semáforo del % SLA de resolución de los tickets del técnico.
	measure 'Color % SLA Resolución Técnico' =
			VAR v = [% SLA Resolución Técnico]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), "#5B6B7F",
			        v >= [Meta % SLA], "#06519A",
			        v >= [Umbral Alerta % SLA], "#C98A00",
			        "#C8382E"
			    )
		displayFolder: Técnicos de Campo
		lineageTag: acbdcedf-e9fa-44ab-95bc-6e7f8091a2bb

	/// Tickets del técnico que incumplieron el SLA de resolución.
	measure 'Tickets Técnico Incumplidos' = CALCULATE([Tickets escalados a N2], SLA_Tickets[SLA Resolución Estado] = "Incumplido")
		formatString: #,##0
		displayFolder: Técnicos de Campo
		lineageTag: bdcedfe0-fa0b-45bc-a6cd-7f8091a2b3cc

	/// Horas promedio de SLA de resolución (JSM) de los tickets en los que participó el técnico.
	measure 'Prom Horas SLA Técnico' = CALCULATE([Prom Horas SLA Resolución], TREATAS(VALUES(FactTecnicos[Key]), SLA_Tickets[Key]))
		formatString: #,##0.00
		displayFolder: Técnicos de Campo
		lineageTag: cedfe0f1-0b1c-46cd-b7de-8091a2b3c4dd

	/// Mediana de horas calendario de resolución de los tickets en los que participó el técnico.
	measure 'Mediana Horas Resolución Técnico' = CALCULATE([Mediana Horas Resolución Calendario], TREATAS(VALUES(FactTecnicos[Key]), SLA_Tickets[Key]))
		formatString: #,##0.00
		displayFolder: Técnicos de Campo
		lineageTag: dfe0f102-1c2d-47de-88ef-91a2b3c4d5ee

	/// En el detalle: cuántos técnicos participaron en el ticket del renglón (en blanco si el técnico no participó).
	measure 'Técnicos en el Ticket' =
			IF(
			    NOT ISEMPTY(FactTecnicos),
			    CALCULATE(
			        DISTINCTCOUNT(FactTecnicos[Técnico]),
			        REMOVEFILTERS(FactTecnicos[Técnico], FactTecnicos[Técnico Account ID])
			    )
			)
		formatString: 0
		displayFolder: Técnicos de Campo
		lineageTag: e0f10213-2d3e-48ef-990a-a2b3c4d5e6ff

	/// Meta de SLA en horas: la del selector "SLA objetivo" si se eligió una; si no, la meta de resolución de Jira
	/// (por ticket, o el promedio cuando hay varios tickets).
	measure 'Meta SLA Ticket' =
			VAR Sel = [Meta SLA Seleccionada]
			RETURN IF(NOT ISBLANK(Sel), Sel, AVERAGE(SLA_Tickets[SLA Resolución Meta Horas]))
		formatString: #,##0.00
		displayFolder: Consumo del SLA
		lineageTag: f1021324-3e4f-490a-8a1b-b3c4d5e6f710

	/// Horas promedio por ticket en cada estado, dividiendo entre TODOS los tickets del grupo (no solo los que pasaron
	/// por el estado). Así las barras apiladas suman el tiempo promedio total de un ticket y se comparan con la meta.
	measure 'Horas en Estado por Ticket' = DIVIDE([Horas en Estado], [Tickets])
		formatString: #,##0.00
		displayFolder: Consumo del SLA
		lineageTag: 02132435-4f50-4a1b-9b2c-c4d5e6f71821

	/// % de la meta del SLA que consumió el tiempo en estados (por ticket o promedio del grupo).
	measure 'Consumo SLA %' = DIVIDE([Horas en Estado por Ticket], [Meta SLA Ticket])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Consumo del SLA
		lineageTag: 13243546-5061-4b2c-8c3d-d5e6f7182932

	/// Horas por encima de la meta del SLA (suma por ticket; en blanco si no se excedió).
	measure 'Excedente SLA Horas' =
			VAR Total =
			    SUMX(
			        VALUES(SLA_Tickets[Key]),
			        VAR H = CALCULATE([Horas en Estado], REMOVEFILTERS(FactStatusHistory[Estado]))
			        VAR M = [Meta SLA Ticket]
			        RETURN IF(NOT ISBLANK(M) && H > M, H - M)
			    )
			RETURN IF(Total > 0, Total)
		formatString: #,##0.00
		displayFolder: Consumo del SLA
		lineageTag: 24354657-6172-4c3d-9d4e-e6f718293a43

	/// Color del consumo del SLA: azul hasta 75%, ámbar hasta 100%, rojo si se excedió.
	measure 'Color Consumo SLA' =
			VAR C = [Consumo SLA %]
			RETURN
			    SWITCH(TRUE(), ISBLANK(C), "#5B6B7F", C > 1, "#C8382E", C > 0.75, "#8A6100", "#06519A")
		displayFolder: Consumo del SLA
		lineageTag: 35465768-7283-4d4e-8e5f-f718293a4b54

	/// Subtítulo con las horas de las metas de SLA de los tickets filtrados (primera respuesta y resolución).
	measure 'Metas SLA Texto' =
			VAR Resp =
			    CONCATENATEX(
			        FILTER(VALUES(SLA_Tickets[SLA Respuesta Meta Horas]), NOT ISBLANK(SLA_Tickets[SLA Respuesta Meta Horas])),
			        IF(
			            SLA_Tickets[SLA Respuesta Meta Horas] < 1,
			            FORMAT(SLA_Tickets[SLA Respuesta Meta Horas] * 60, "0") & " min",
			            FORMAT(SLA_Tickets[SLA Respuesta Meta Horas], "0.##") & " h"
			        ),
			        " / ", SLA_Tickets[SLA Respuesta Meta Horas], ASC
			    )
			VAR Res =
			    CONCATENATEX(
			        FILTER(VALUES(SLA_Tickets[SLA Resolución Meta Horas]), NOT ISBLANK(SLA_Tickets[SLA Resolución Meta Horas])),
			        FORMAT(SLA_Tickets[SLA Resolución Meta Horas], "0.##") & " h",
			        " / ", SLA_Tickets[SLA Resolución Meta Horas], ASC
			    )
			RETURN
			    "Horas del SLA · Primera respuesta: " & IF(Resp = "", "sin meta", Resp)
			        & "   ·   Resolución: " & IF(Res = "", "sin meta", Res) & " (según el tipo de ticket)"
		displayFolder: SLA
		lineageTag: 4657687a-8394-4e5f-9f60-0718293a4b65

	/// Línea de tiempo a nivel equipo: cuántos tickets estaban en ese estado durante esa hora desde su creación (sin desglosar por ticket). No incluye estados finales.
	measure 'Gantt Estado Equipo' =
			VAR H = SELECTEDVALUE('Línea de Tiempo'[Hora])
			VAR Ultima = CALCULATE(MAX('Línea de Tiempo'[Hora]), ALL('Línea de Tiempo'))
			VAR Tickets =
			    COUNTROWS(
			        FILTER(
			            FactStatusHistory,
			            FactStatusHistory[Es Estado Final] = FALSE()
			                && FactStatusHistory[Hora Fin] > H
			                && (H = Ultima || FactStatusHistory[Hora Inicio] < H + 1)
			        )
			    )
			RETURN
			    IF(NOT ISBLANK(H) && Tickets > 0, Tickets)
		formatString: 0
		displayFolder: Línea de Tiempo
		lineageTag: 4dd47767-b2f0-4596-880f-9e780d040ab1

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", Int64.Type}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table


		displayFolder: SLA Calendarios
		lineageTag: af86924f-0879-405f-b304-1b0c8f767acf

	/// Tickets que pasaron la meta de resolución (calendario RAM).
	measure 'Resolución Incumplidos RAM' = CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado RAM] = "Incumplido")
		formatString: #,##0
		displayFolder: SLA Calendarios
		lineageTag: ec45abb3-c63c-48de-b9e9-2848606871c2

	/// % de cumplimiento del SLA de resolución (calendario RAM). Solo tickets con resultado definido.
	measure '% SLA Resolución RAM' = DIVIDE([Resolución Cumplidos RAM], [Resolución Cumplidos RAM] + [Resolución Incumplidos RAM])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA Calendarios
		lineageTag: 19af8032-7ea7-4e99-a3ab-d08016dc3e93

	/// Promedio de horas de SLA de resolución de los tickets resueltos (calendario RAM, sin pausas).
	measure 'Prom Horas SLA Resolución RAM' = AVERAGEX(FILTER(SLA_Tickets, NOT ISBLANK(SLA_Tickets[Fecha Resolución])), SLA_Tickets[SLA Resolución Horas RAM])
		displayFolder: SLA Calendarios
		lineageTag: f9ed33c3-9d19-4f59-ad36-e113dd45db65

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Tickets con primer comentario dentro de la meta (calendario RAM).
	measure 'Respuesta Cumplidos RAM' = CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado RAM] = "Cumplido")
		formatString: #,##0
		displayFolder: SLA Calendarios
		lineageTag: 30458895-b45a-43ba-beb4-8c45266a169e

	/// Tickets con primera respuesta fuera de la meta o abiertos sin comentario después de la meta (calendario RAM).
	measure 'Respuesta Incumplidos RAM' = CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado RAM] = "Incumplido")
		formatString: #,##0
		displayFolder: SLA Calendarios
		lineageTag: 615a6267-1c9b-48a6-b4f0-9d6a6b836855

	/// % de cumplimiento del SLA de primera respuesta (calendario RAM). No cuenta 'Sin dato' ni 'En curso'.
	measure '% SLA Respuesta RAM' = DIVIDE([Respuesta Cumplidos RAM], [Respuesta Cumplidos RAM] + [Respuesta Incumplidos RAM])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SLA Calendarios
		lineageTag: 4c03b00f-50bb-462d-b1c6-532a7e199c66

	/// Promedio de horas a la primera respuesta de los tickets con comentario (calendario RAM).
	measure 'Prom Horas SLA Respuesta RAM' = AVERAGEX(FILTER(SLA_Tickets, NOT ISBLANK(SLA_Tickets[Primer Comentario])), SLA_Tickets[SLA Respuesta Horas RAM])
		displayFolder: SLA Calendarios
		lineageTag: ccfd0a0a-b021-4ea8-af97-d8b685c19c6c

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Promedio del tiempo real (sin descontar pausas) de la creación a la resolución.
	measure 'Prom Horas Naturales Resolución' = AVERAGEX(FILTER(SLA_Tickets, NOT ISBLANK(SLA_Tickets[Fecha Resolución])), SLA_Tickets[Horas Naturales])
		displayFolder: SLA Calendarios
		lineageTag: 67dbc65f-f207-43cd-931e-5a9099c5a621

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Tickets que se reabrieron y hoy siguen abiertos.
	measure 'Tickets Reabiertos Abiertos' = CALCULATE([Tickets], SLA_Tickets[Situación del Ticket] = "Reabierto (abierto)")
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: 4a3d7bef-9d48-4289-aadb-7fe50dd81ca3

	/// Tickets que pasaron alguna vez por Reabierta (resueltos o no).
	measure 'Tickets con Reapertura' = CALCULATE([Tickets], SLA_Tickets[Fue Reabierto] = TRUE())
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: 9579e105-b5ab-4931-825b-1f5263d58820

	/// Tickets en Cerrada. La consulta excluye status Closed, así que normalmente es 0.
	measure 'Tickets Cerrados' = CALCULATE([Tickets], SLA_Tickets[Status] = "Cerrada")
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: c0699151-78ae-4fe6-bbbd-106213ecef46

	/// Tickets sin fecha de resolución (abiertos): su tiempo es acumulado, no definitivo.
	measure 'Tickets Sin Fecha Resolución' = CALCULATE([Tickets], ISBLANK(SLA_Tickets[Fecha Resolución]))
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: 48ff5ae1-99a2-46bb-82be-24d274b9bc2b

	/// Tickets resueltos sin Resolved en Jira: su fecha de resolución es la entrada a Resuelta del historial.
	measure 'Tickets Resolved desde Historial' = CALCULATE([Tickets], SLA_Tickets[Fuente Fecha Resolución] = "Entrada a Resuelta (historial)")
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: b27afa26-c8f4-436f-adce-b5bf7069843a

	/// Tickets resueltos sin ningún comentario del equipo: no se puede medir su primera respuesta.
	measure 'Tickets Sin Primera Respuesta' = CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado] = "Sin dato")
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: e10c068a-5a70-4725-9986-e0350e13fe07

	/// Tickets sin historial de estados: no se pueden descontar pausas ni medir el calendario RAM.
	measure 'Tickets Sin Historial' = CALCULATE([Tickets], FILTER(SLA_Tickets, ISEMPTY(RELATEDTABLE(FactStatusHistory))))
		formatString: #,##0
		displayFolder: Calidad de datos
		lineageTag: e8156313-96e1-477b-9935-0eebc62197aa

	/// % de los tickets del periodo que ya se resolvieron.
	measure 'Texto % Resueltos Jira' =
			VAR P = DIVIDE([Tickets Resueltos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: 5550adeb-3a45-44fa-8982-839a262c8265

	/// % de los tickets del periodo que siguen pendientes.
	measure 'Texto % Pendientes Jira' =
			VAR P = DIVIDE([Tickets Abiertos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: 94c724b5-6d7f-482c-984a-fa3282c9d921

	/// % del total que cumplió el SLA de primera respuesta.
	measure 'Texto % Respuesta Cumplidos' =
			VAR P = DIVIDE([SLA Respuesta Cumplidos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: 25a3350e-9289-4daa-a671-7c8566392fb2

	/// % del total que no cumplió el SLA de primera respuesta.
	measure 'Texto % Respuesta Incumplidos' =
			VAR P = DIVIDE([SLA Respuesta Incumplidos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: 5b21c2ab-811e-4c71-ab8d-2949ba54d4b1

	/// % del total que cumplió el SLA de resolución.
	measure 'Texto % Resolución Cumplidos' =
			VAR P = DIVIDE([SLA Resolución Cumplidos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: fcafbb25-cbb4-4d9d-839d-31a20bc65ca4

	/// % del total que no cumplió el SLA de resolución.
	measure 'Texto % Resolución Incumplidos' =
			VAR P = DIVIDE([SLA Resolución Incumplidos], [Tickets])
			RETURN IF(ISBLANK(P), BLANK(), FORMAT(P, "0%") & " del total")
		displayFolder: Resumen ejecutivo
		lineageTag: a67c0fa4-d96d-4e33-9a00-aa191fd5cba3

	/// Tiempo promedio a la primera respuesta (primer comentario) en formato legible, con el calendario elegido.
	measure 'Tiempo Promedio a Primera Respuesta' =
			VAR Hrs = [Prom Horas SLA Respuesta]
			VAR M = ROUND(Hrs * 60, 0)
			VAR D = INT(M / 1440)
			VAR H = INT(MOD(M, 1440) / 60)
			VAR Mi = MOD(M, 60)
			RETURN
			    IF(ISBLANK(Hrs), BLANK(),
			        IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min",
			            IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		displayFolder: Resumen ejecutivo
		lineageTag: b0431211-e068-41e2-9555-255a4dc651e8

	/// Tiempo promedio de SLA de resolución (sin pausas) en formato legible, con el calendario elegido.
	measure 'Tiempo Promedio a Resolución' =
			VAR Hrs = [Prom Horas SLA Resolución]
			VAR M = ROUND(Hrs * 60, 0)
			VAR D = INT(M / 1440)
			VAR H = INT(MOD(M, 1440) / 60)
			VAR Mi = MOD(M, 60)
			RETURN
			    IF(ISBLANK(Hrs), BLANK(),
			        IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min",
			            IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		displayFolder: Resumen ejecutivo
		lineageTag: 0af26e67-3a17-4cc5-ae80-c2c62329b64d

	/// Metas de primera respuesta de los tickets en pantalla (ej. 'Meta: 30 min / 4 h') y el calendario elegido.
	measure 'Meta Primera Respuesta Texto' =
			"Meta: " & CONCATENATEX(
			    FILTER(VALUES(SLA_Tickets[SLA Respuesta Meta Horas]), NOT ISBLANK(SLA_Tickets[SLA Respuesta Meta Horas])),
			    IF(SLA_Tickets[SLA Respuesta Meta Horas] < 1, FORMAT(SLA_Tickets[SLA Respuesta Meta Horas] * 60, "0") & " min", FORMAT(SLA_Tickets[SLA Respuesta Meta Horas], "0.##") & " h"),
			    " / ", SLA_Tickets[SLA Respuesta Meta Horas], ASC) & " · " & [Calendario SLA Elegido]
		displayFolder: Resumen ejecutivo
		lineageTag: b41e87f2-0c03-4e95-be81-a6f71ef67432

	/// Metas de resolución de los tickets en pantalla (ej. 'Meta: 15 h / 24 h') y el calendario elegido.
	measure 'Meta Resolución Texto' =
			"Meta: " & CONCATENATEX(
			    FILTER(VALUES(SLA_Tickets[SLA Resolución Meta Horas]), NOT ISBLANK(SLA_Tickets[SLA Resolución Meta Horas])),
			    IF(SLA_Tickets[SLA Resolución Meta Horas] < 1, FORMAT(SLA_Tickets[SLA Resolución Meta Horas] * 60, "0") & " min", FORMAT(SLA_Tickets[SLA Resolución Meta Horas], "0.##") & " h"),
			    " / ", SLA_Tickets[SLA Resolución Meta Horas], ASC) & " · " & [Calendario SLA Elegido]
		displayFolder: Resumen ejecutivo
		lineageTag: 3f5a304a-c244-4b9e-bf38-b9048b290d27

	/// Tickets de cada SLA en cada estado (calendario elegido). Para 'Cumplimiento de los SLA'.
	measure 'Tickets por Estado de SLA' =
			VAR Sla = SELECTEDVALUE('SLA Comparación'[SLA])
			VAR Est = SELECTEDVALUE('Estado SLA'[Estado del SLA])
			VAR UsaRAM = [Calendario Es RAM]
			RETURN
			    SWITCH(TRUE(),
			        Sla = "Primera respuesta" && UsaRAM, CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado RAM] = Est),
			        Sla = "Primera respuesta", CALCULATE([Tickets], SLA_Tickets[SLA Respuesta Estado] = Est),
			        UsaRAM, CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado RAM] = Est),
			        CALCULATE([Tickets], SLA_Tickets[SLA Resolución Estado] = Est))
		formatString: #,##0
		displayFolder: Gráficas
		lineageTag: 5ff431e3-89ac-438b-8e66-d1052c9ef7c2

	/// % de los tickets de cada SLA en cada estado (las barras suman 100%). Se muestra como 86% (32).
	measure '% por Estado de SLA' = DIVIDE([Tickets por Estado de SLA], [Tickets])
		displayFolder: Gráficas
		lineageTag: 40d3b0e0-4e73-4836-8abf-2f6970dff59f

		formatStringDefinition = "0% ""(" & FORMAT([Tickets por Estado de SLA], "#,##0") & ")"""

	/// Tickets con resultado de primera respuesta (cumplidos + incumplidos).
	measure 'Respuesta Evaluados' = [SLA Respuesta Cumplidos] + [SLA Respuesta Incumplidos]
		formatString: #,##0
		displayFolder: Gráficas
		lineageTag: 41552bc3-e6c6-4b5a-aa71-3ca76ca7beae

	/// Tickets con resultado de resolución (cumplidos + incumplidos).
	measure 'Resolución Evaluados' = [SLA Resolución Cumplidos] + [SLA Resolución Incumplidos]
		formatString: #,##0
		displayFolder: Gráficas
		lineageTag: f5d530df-2d2f-40da-b9db-45bf0ad4e9e4

	/// Tickets resueltos dentro del periodo (por fecha de resolución), aunque se hayan creado antes.
	measure 'Tickets Resueltos en Periodo' = CALCULATE([Tickets], REMOVEFILTERS(DimFecha), TREATAS(VALUES(DimFecha[Date]), SLA_Tickets[Fecha Resolución Día]))
		formatString: #,##0
		displayFolder: Gráficas
		lineageTag: 23c646df-5fca-4ac9-bcd9-68e88e2a38ac

	/// Tickets creados; la etiqueta muestra además el % sobre el total creado en el periodo.
	measure 'Creados con %' = [Tickets]
		displayFolder: Gráficas
		lineageTag: 0070be60-9f7d-42bf-b12d-ebf55ecb0080

		formatStringDefinition = "#,##0 ""(" & FORMAT(DIVIDE([Tickets], CALCULATE([Tickets], ALLSELECTED(DimFecha))), "0%") & ")"""

	/// Tickets resueltos; la etiqueta muestra además el % sobre el total resuelto en el periodo.
	measure 'Resueltos con %' = [Tickets Resueltos en Periodo]
		displayFolder: Gráficas
		lineageTag: a142fc96-db0b-4a8f-95fb-4ec0345d2b43

		formatStringDefinition = "#,##0 ""(" & FORMAT(DIVIDE([Tickets Resueltos en Periodo], CALCULATE([Tickets Resueltos en Periodo], ALLSELECTED(DimFecha))), "0%") & ")"""

	/// Tiempo promedio en estado por ticket, sin esperas de terceros (cliente y proveedor) ni Resuelta/Cerrada, con el horario elegido.
	measure 'Tiempo Promedio por Ticket en Estados' =
			VAR Hrs = CALCULATE([Prom Horas en Estado], NOT (FactStatusHistory[Estado] IN {"Esperando por el cliente", "Esperando al proveedor"}))
			VAR M = ROUND(Hrs * 60, 0)
			VAR D = INT(M / 1440)
			VAR H = INT(MOD(M, 1440) / 60)
			VAR Mi = MOD(M, 60)
			RETURN
			    IF(ISBLANK(Hrs), BLANK(),
			        IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min",
			            IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		displayFolder: Time in Status
		lineageTag: 640c8dc3-4d4f-4093-99b7-3daee5b7cd1a

	/// Estado donde los tickets pasan más horas en promedio, sin contar esperas de terceros (cliente y proveedor).
	measure 'Estado con Más Tiempo' =
			VAR Tabla = FILTER(ADDCOLUMNS(FILTER(VALUES(FactStatusHistory[Estado]), NOT (FactStatusHistory[Estado] IN {"Esperando por el cliente", "Esperando al proveedor"})), "@h", [Prom Horas en Estado]), NOT ISBLANK([@h]))
			VAR Primero = TOPN(1, Tabla, [@h], DESC)
			RETURN IF(ISEMPTY(Primero), BLANK(), MAXX(Primero, FactStatusHistory[Estado]) & " · " & FORMAT(MAXX(Primero, [@h]), "#,##0.0") & " h prom.")
		displayFolder: Time in Status
		lineageTag: 41e3d2ee-bd49-4ea9-a452-c2707ce69c57

	/// % del tiempo en estados de espera (cliente, proveedor, planta externa) sobre el tiempo total en estados.
	measure '% Tiempo en Espera' =
			DIVIDE(
			    CALCULATE([Horas en Estado], FactStatusHistory[Estado] IN {"Esperando por el cliente", "Esperando al proveedor", "Planta externa"}),
			    [Horas en Estado]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time in Status
		lineageTag: 9edb6975-619f-4498-91fd-615a5e3356c0

	/// Tiempo promedio en Nueva solicitud: lo que tarda un ticket en empezar a atenderse.
	measure 'Tiempo Promedio Sin Atender' =
			VAR Hrs = CALCULATE([Prom Horas en Estado], FactStatusHistory[Estado] = "Nueva solicitud")
			VAR M = ROUND(Hrs * 60, 0)
			VAR D = INT(M / 1440)
			VAR H = INT(MOD(M, 1440) / 60)
			VAR Mi = MOD(M, 60)
			RETURN
			    IF(ISBLANK(Hrs), BLANK(),
			        IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min",
			            IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		displayFolder: Time in Status
		lineageTag: f2fd0567-1db4-40d1-8b40-d83b5ebe32f8

	/// Request type con el menor % de cumplimiento del SLA de resolución (con al menos 5 tickets evaluados), con el calendario elegido.
	measure 'Request Type con Menor % SLA' =
			VAR Tab = FILTER(ADDCOLUMNS(VALUES(SLA_Tickets[Request Type]), "@p", [% SLA Resolución], "@n", [Resolución Evaluados]), [@n] >= 5 && NOT ISBLANK([@p]))
			VAR Peor = TOPN(1, Tab, [@p], ASC)
			RETURN IF(ISEMPTY(Peor), BLANK(), MAXX(Peor, SLA_Tickets[Request Type]) & " · " & FORMAT(MAXX(Peor, [@p]), "0%"))
		displayFolder: Resumen ejecutivo
		lineageTag: 482b91bb-ebf0-4f8f-a58d-30286d837c1b

	/// Cuántos cumplen y cuántos no el SLA de respuesta (calendario elegido), para dentro de la tarjeta.
	measure 'Texto Cumplen Respuesta' = FORMAT([SLA Respuesta Cumplidos] + 0, "#,##0") & " cumplen  ·  " & FORMAT([SLA Respuesta Incumplidos] + 0, "#,##0") & " no cumplen"
		displayFolder: Resumen ejecutivo
		lineageTag: 758616a1-4aa9-47fa-9c56-f117b333db96

	/// Cuántos cumplen y cuántos no el SLA de resolución (calendario elegido), para dentro de la tarjeta.
	measure 'Texto Cumplen Resolución' = FORMAT([SLA Resolución Cumplidos] + 0, "#,##0") & " cumplen  ·  " & FORMAT([SLA Resolución Incumplidos] + 0, "#,##0") & " no cumplen"
		displayFolder: Resumen ejecutivo
		lineageTag: 63ea07d1-1a8c-46d7-abe1-56e5a458acf3

	/// Horas promedio en el estado como texto ("111h 20m"). "N/A" si ninguno de esos tickets pasó por el estado (no le toca).
	measure 'Texto Horas Promedio en Estado' =
			VAR Hrs = [Prom Horas en Estado]
			VAR M = ROUND(Hrs * 60, 0)
			VAR H = INT(M / 60)
			VAR Mi = MOD(M, 60)
			-- N/A: el tipo de solicitud tiene tickets, pero ninguno pasó por este estado (no le toca)
			VAR HayTickets = COUNTROWS(SLA_Tickets) > 0
			RETURN
			    SWITCH(TRUE(),
			        NOT ISBLANK(Hrs), IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m"),
			        MAXX(FILTERS(FactStatusHistory[Estado]), FactStatusHistory[Estado]) IN {"Resuelta", "Cerrada"}, BLANK(),
			        HayTickets, "N/A",
			        BLANK())
		displayFolder: Time in Status
		lineageTag: 476a551c-fb7e-4453-9ec4-125409f112f7

	/// Tickets con tiempo registrado en estados (base para promediar los grupos de tiempo).
	measure 'Tickets con Tiempo' = CALCULATE([Tickets en Estado], REMOVEFILTERS(FactStatusHistory[Estado]))
		displayFolder: Time in Status
		lineageTag: bd72d7ce-8a33-42b1-b257-7d8f5b6ab94a

	/// Horas promedio por ticket: antes de la primera atención (sobre todos los tickets, para que los grupos se puedan sumar).
	measure 'Prom Horas Antes de Atender' = DIVIDE(CALCULATE([Horas en Estado], FactStatusHistory[Estado] IN {"Nueva solicitud"}), [Tickets con Tiempo])
		displayFolder: Time in Status
		lineageTag: eae35834-3e03-43b8-a2b7-132aa1457699

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Antes de la primera atención: horas promedio por ticket como texto ('5h 20m').
	measure 'Texto Prom Horas Antes de Atender' =
			VAR Hrs = [Prom Horas Antes de Atender]
			VAR M = ROUND(Hrs * 60, 0)
			RETURN IF(ISBLANK(Hrs), BLANK(), IF(INT(M / 60) > 0, INT(M / 60) & "h " & FORMAT(MOD(M, 60), "00") & "m", MOD(M, 60) & "m"))
		displayFolder: Time in Status
		lineageTag: 459fd234-c18c-4a0b-b0aa-48400ae597a2

	/// Horas promedio por ticket: trabajo de la mesa (sobre todos los tickets, para que los grupos se puedan sumar).
	measure 'Prom Horas de Trabajo' = DIVIDE(CALCULATE([Horas en Estado], NOT (FactStatusHistory[Estado] IN {"Nueva solicitud", "Esperando por el cliente", "Esperando al proveedor", "Planta externa"})), [Tickets con Tiempo])
		displayFolder: Time in Status
		lineageTag: 9a62fb7f-95c8-4143-9dd6-8f21096a12d6

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Trabajo de la mesa: horas promedio por ticket como texto ('5h 20m').
	measure 'Texto Prom Horas de Trabajo' =
			VAR Hrs = [Prom Horas de Trabajo]
			VAR M = ROUND(Hrs * 60, 0)
			RETURN IF(ISBLANK(Hrs), BLANK(), IF(INT(M / 60) > 0, INT(M / 60) & "h " & FORMAT(MOD(M, 60), "00") & "m", MOD(M, 60) & "m"))
		displayFolder: Time in Status
		lineageTag: f492064e-7acf-42c2-8bc0-4e15ed7c849f

	/// Horas promedio por ticket: espera del cliente (sobre todos los tickets, para que los grupos se puedan sumar).
	measure 'Prom Horas Espera Cliente' = DIVIDE(CALCULATE([Horas en Estado], FactStatusHistory[Estado] IN {"Esperando por el cliente"}), [Tickets con Tiempo])
		displayFolder: Time in Status
		lineageTag: 76e39c09-5c53-4ed1-bd7a-18ebb75efabd

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Espera del cliente: horas promedio por ticket como texto ('5h 20m').
	measure 'Texto Prom Horas Espera Cliente' =
			VAR Hrs = [Prom Horas Espera Cliente]
			VAR M = ROUND(Hrs * 60, 0)
			RETURN IF(ISBLANK(Hrs), BLANK(), IF(INT(M / 60) > 0, INT(M / 60) & "h " & FORMAT(MOD(M, 60), "00") & "m", MOD(M, 60) & "m"))
		displayFolder: Time in Status
		lineageTag: 09ceecdc-ca38-47e3-ad45-35c6af646444

	/// Horas promedio por ticket: espera de proveedor / terceros (sobre todos los tickets, para que los grupos se puedan sumar).
	measure 'Prom Horas Espera Terceros' = DIVIDE(CALCULATE([Horas en Estado], FactStatusHistory[Estado] IN {"Esperando al proveedor", "Planta externa"}), [Tickets con Tiempo])
		displayFolder: Time in Status
		lineageTag: b0f0541a-6175-49dd-96c1-f7254a8ab048

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Espera de proveedor / terceros: horas promedio por ticket como texto ('5h 20m').
	measure 'Texto Prom Horas Espera Terceros' =
			VAR Hrs = [Prom Horas Espera Terceros]
			VAR M = ROUND(Hrs * 60, 0)
			RETURN IF(ISBLANK(Hrs), BLANK(), IF(INT(M / 60) > 0, INT(M / 60) & "h " & FORMAT(MOD(M, 60), "00") & "m", MOD(M, 60) & "m"))
		displayFolder: Time in Status
		lineageTag: 96e88df0-94b3-4cb8-952c-2f8805ad9a36

	/// Horas promedio por ticket del grupo de tiempo (para la gráfica de trabajo vs. esperas).
	measure 'Horas por Grupo de Tiempo' = SWITCH(SELECTEDVALUE('Grupo de Tiempo'[Grupo]), "Antes de la primera atención", [Prom Horas Antes de Atender], "Trabajo de la mesa", [Prom Horas de Trabajo], "Espera del cliente", [Prom Horas Espera Cliente], "Espera de proveedor / terceros", [Prom Horas Espera Terceros])
		displayFolder: Time in Status
		lineageTag: 61a7fa95-edcd-45eb-b140-c7d13b58082a

		formatStringDefinition = VAR Hrs = SELECTEDMEASURE() VAR M = ROUND(Hrs * 60, 0) VAR H = INT(M / 60) VAR Mi = MOD(M, 60) RETURN """" & IF(H > 0, H & "h " & FORMAT(Mi, "00") & "m", Mi & "m") & """"

	/// Color de cada grupo de tiempo.
	measure 'Color Grupo de Tiempo' = SWITCH(SELECTEDVALUE('Grupo de Tiempo'[Grupo]), "Antes de la primera atención", "#8A97A8", "Trabajo de la mesa", "#06519A", "Espera del cliente", "#C8382E", "Espera de proveedor / terceros", "#0A2E5C")
		displayFolder: Time in Status
		lineageTag: 1ee49b9c-954f-4ca2-94f1-92d5cadbb298

	/// Dibujo SVG de 'Tiempo de trabajo vs. espera de terceros': barras apiladas por tipo de servicio (antes de atender,
	/// trabajo de la mesa, espera del cliente, espera de proveedor / planta externa), horas en cada tramo y leyenda.
	measure 'Gráfica Trabajo vs Espera' =
			VAR Filas =
			    ADDCOLUMNS(
			        VALUES(SLA_Tickets[Flujo]),
			        "@a", [Prom Horas Antes de Atender] + 0,
			        "@t", [Prom Horas de Trabajo] + 0,
			        "@c", [Prom Horas Espera Cliente] + 0,
			        "@e", [Prom Horas Espera Terceros] + 0
			    )
			VAR ConTotal = ADDCOLUMNS(FILTER(Filas, [@a] + [@t] + [@c] + [@e] > 0), "@tot", [@a] + [@t] + [@c] + [@e])
			VAR N = COUNTROWS(ConTotal)
			VAR Escala = DIVIDE(290, MAXX(ConTotal, [@tot]))
			VAR Ordenadas = ADDCOLUMNS(ConTotal, "@i", RANKX(ConTotal, SLA_Tickets[Flujo], , ASC, DENSE))
			VAR Barras =
			    CONCATENATEX(
			        Ordenadas,
			        VAR y = 14 + ([@i] - 1) * 64
			        VAR w1 = INT([@a] * Escala) VAR w2 = INT([@t] * Escala) VAR w3 = INT([@c] * Escala) VAR w4 = INT([@e] * Escala)
			        VAR x1 = 150 VAR x2 = x1 + w1 VAR x3 = x2 + w2 VAR x4 = x3 + w3 VAR x5 = x4 + w4
			        VAR Nombre = IF(LEFT(SLA_Tickets[Flujo], 8) = "Proyecto", "IEP", SLA_Tickets[Flujo])
			        RETURN
			            "<text x='0' y='" & y + 24 & "' font-size='15' font-weight='600' fill='%230A2E5C'>" & Nombre & "</text>"
			            & "<rect x='" & x1 & "' y='" & y & "' width='" & w1 & "' height='36' fill='%238A97A8'/>"
			            & "<rect x='" & x2 & "' y='" & y & "' width='" & w2 & "' height='36' fill='%2306519A'/>"
			            & "<rect x='" & x3 & "' y='" & y & "' width='" & w3 & "' height='36' fill='%23C8382E'/>"
			            & "<rect x='" & x4 & "' y='" & y & "' width='" & w4 & "' height='36' fill='%230A2E5C'/>"
			            & IF(w1 >= 30, "<text x='" & INT(x1 + w1 / 2) & "' y='" & y + 23 & "' font-size='12' fill='white' text-anchor='middle'>" & IF([@a] < 1, FORMAT([@a] * 60, "0") & "m", FORMAT([@a], "0") & "h") & "</text>")
			            & IF(w2 >= 30, "<text x='" & INT(x2 + w2 / 2) & "' y='" & y + 23 & "' font-size='12' fill='white' text-anchor='middle'>" & IF([@t] < 1, FORMAT([@t] * 60, "0") & "m", FORMAT([@t], "0") & "h") & "</text>")
			            & IF(w3 >= 30, "<text x='" & INT(x3 + w3 / 2) & "' y='" & y + 23 & "' font-size='12' fill='white' text-anchor='middle'>" & IF([@c] < 1, FORMAT([@c] * 60, "0") & "m", FORMAT([@c], "0") & "h") & "</text>")
			            & IF(w4 >= 30, "<text x='" & INT(x4 + w4 / 2) & "' y='" & y + 23 & "' font-size='12' fill='white' text-anchor='middle'>" & IF([@e] < 1, FORMAT([@e] * 60, "0") & "m", FORMAT([@e], "0") & "h") & "</text>")
			            & "<text x='" & x5 + 8 & "' y='" & y + 24 & "' font-size='14' font-weight='600' fill='%231A1A1A'>" & FORMAT([@tot], "0") & "h</text>",
			        "",
			        [@i], ASC
			    )
			VAR yL = 14 + N * 64 + 10
			VAR Leyenda =
			    "<rect x='0' y='" & yL + 0 & "' width='14' height='14' fill='%238A97A8'/><text x='22' y='" & yL + 12 & "' font-size='13' fill='%231A1A1A'>Antes de la primera atenci&#243;n</text>"
			    & "<rect x='0' y='" & yL + 22 & "' width='14' height='14' fill='%2306519A'/><text x='22' y='" & yL + 34 & "' font-size='13' fill='%231A1A1A'>Trabajo de la mesa</text>"
			    & "<rect x='0' y='" & yL + 44 & "' width='14' height='14' fill='%23C8382E'/><text x='22' y='" & yL + 56 & "' font-size='13' fill='%231A1A1A'>Espera del cliente</text>"
			    & "<rect x='0' y='" & yL + 66 & "' width='14' height='14' fill='%230A2E5C'/><text x='22' y='" & yL + 78 & "' font-size='13' fill='%231A1A1A'>Espera de proveedor / planta externa</text>"
			VAR Alto = yL + 92
			RETURN
			    IF(
			        N > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='520' height='" & Alto & "' viewBox='0 0 520 " & Alto
			            & "' font-family='Segoe UI, sans-serif'>" & Barras & Leyenda & "</svg>"
			    )
		displayFolder: Time in Status
		lineageTag: 2a028eac-b9a6-4702-a4de-ad929be04af3
		dataCategory: ImageUrl

	/// Tickets en los que la persona estuvo asignada al menos una vez (cada ticket cuenta 1, resuelto o no).
	measure 'Tickets Asignados' = CALCULATE(DISTINCTCOUNT(FactAssigneeHistory[Key]), KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar"))
		formatString: #,##0
		displayFolder: Time in Assignee
		lineageTag: c943a961-7861-4c1b-8fb6-b29a569a947a

	/// Veces que alguien quedó asignado a un ticket (si regresa al mismo ticket, cuenta otra vez).
	measure Participaciones = CALCULATE(COUNTROWS(FactAssigneeHistory), KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar"))
		formatString: #,##0
		displayFolder: Time in Assignee
		lineageTag: 40a0707d-02f7-4e1c-8b33-e647a92e8c82

	/// Veces promedio que una persona participa (queda asignada) en un mismo ticket.
	measure 'Participaciones por Ticket' = DIVIDE([Participaciones], [Tickets Asignados])
		formatString: #,##0.0
		displayFolder: Time in Assignee
		lineageTag: 703a6ca0-00e5-428e-97a1-bcb332ce2571

	/// Personas distintas que han tenido tickets asignados.
	measure 'Personas Asignadas' = CALCULATE(DISTINCTCOUNT(FactAssigneeHistory[Responsable]), KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar"))
		formatString: #,##0
		displayFolder: Time in Assignee
		lineageTag: a5d66710-f8f1-4c8c-b303-1caea18c3888

	/// Personas distintas que en promedio participan en un ticket.
	measure 'Personas por Ticket Asignado' = AVERAGEX(FILTER(VALUES(FactAssigneeHistory[Key]), [Tickets Asignados] > 0), CALCULATE(DISTINCTCOUNT(FactAssigneeHistory[Responsable]), KEEPFILTERS(FactAssigneeHistory[Responsable] <> "Sin asignar")))
		formatString: #,##0.0
		displayFolder: Time in Assignee
		lineageTag: 968aa2ea-a8cc-4089-b61f-89fc68fc08ba

	/// Horas promedio que una persona tiene asignado un ticket en el que participa (solo tickets resueltos), como texto.
	measure 'Tiempo Promedio de Participación' =
			VAR Hrs = [Prom Horas Asignado por Ticket]
			VAR M = ROUND(Hrs * 60, 0)
			RETURN IF(ISBLANK(Hrs), BLANK(), IF(INT(M / 60) > 0, INT(M / 60) & "h " & FORMAT(MOD(M, 60), "00") & "m", MOD(M, 60) & "m"))
		displayFolder: Time in Assignee
		lineageTag: 8b9e7836-38c4-45b3-b5f8-73e78ece8d9a

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", Int64.Type}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table


/// Un renglón por cada tramo que un ticket pasó en un estado (desde el changelog). Base para Time in Status.
table FactStatusHistory
	lineageTag: 98b96567-1c90-433a-9f47-84369430b6cd

	column Key
		dataType: string
		lineageTag: beb63574-5b55-49a6-b2d0-bf281d6b0a42
		summarizeBy: none
		sourceColumn: Key

		annotation SummarizationSetBy = Automatic

	column Flujo
		dataType: string
		lineageTag: 76910dea-1866-480b-928d-580656023305
		summarizeBy: none
		sourceColumn: Flujo

		annotation SummarizationSetBy = Automatic

	column Estado
		dataType: string
		lineageTag: 66fa729f-30d8-4beb-aa0d-9b845922a959
		summarizeBy: none
		sourceColumn: Estado
		sortByColumn: 'Orden Estado'

		annotation SummarizationSetBy = Automatic

	column 'Orden Estado'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 483c099e-a55c-4ee6-91fe-bbace7c50d2c
		summarizeBy: none
		sourceColumn: Orden Estado

		annotation SummarizationSetBy = Automatic

	/// Categoría de Jira del estado: Por hacer / En curso / Listo.
	column 'Categoría Estado'
		dataType: string
		lineageTag: bd325064-946c-4943-aa72-3258bfa4ec11
		summarizeBy: none
		sourceColumn: Categoría Estado

		annotation SummarizationSetBy = Automatic

	/// TRUE si el estado es final (categoría "done": Resuelta, Cerrada). Se excluyen de las medidas de Time in Status.
	column 'Es Estado Final'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 0ebb59d1-14dc-42f5-a9d1-4458cb398ccc
		summarizeBy: none
		sourceColumn: Es Estado Final

		annotation SummarizationSetBy = Automatic

	/// Número de vez que el ticket entra a un estado (1 = primera vez).
	column Visita
		dataType: int64
		formatString: 0
		lineageTag: a3b11ac1-9f64-4b72-8f93-838b5a97dae5
		summarizeBy: none
		sourceColumn: Visita

		annotation SummarizationSetBy = Automatic

	column Inicio
		dataType: dateTime
		formatString: General Date
		lineageTag: 02481755-6112-4731-8f80-bf0471bf781a
		summarizeBy: none
		sourceColumn: Inicio

		annotation SummarizationSetBy = Automatic

	/// Fin del tramo. Si el ticket sigue en ese estado, es la hora del último refresh.
	column Fin
		dataType: dateTime
		formatString: General Date
		lineageTag: 672a366c-0043-4b29-ac38-a24232fa8b00
		summarizeBy: none
		sourceColumn: Fin

		annotation SummarizationSetBy = Automatic

	/// Horas calendario del tramo.
	column Horas
		dataType: double
		formatString: #,##0.00
		lineageTag: cd90129b-9673-4db9-944d-74a61bea83a1
		summarizeBy: none
		sourceColumn: Horas

		annotation SummarizationSetBy = Automatic

	/// TRUE si es el estado actual del ticket (tramo todavía abierto).
	column 'Es Actual'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 53183cf8-506d-4bf7-999c-082f89dbd9b5
		summarizeBy: none
		sourceColumn: Es Actual

		annotation SummarizationSetBy = Automatic

	/// Horas desde la creación del ticket hasta el inicio del tramo (para la línea de tiempo).
	column 'Hora Inicio'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 23d4e5f6-0718-4293-9da4-e5f60718293a
		summarizeBy: none
		sourceColumn: Hora Inicio

		annotation SummarizationSetBy = Automatic

	/// Horas desde la creación del ticket hasta el fin del tramo (para la línea de tiempo).
	column 'Hora Fin'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 34e5f607-1829-43a4-8eb5-f60718293a4b
		summarizeBy: none
		sourceColumn: Hora Fin

		annotation SummarizationSetBy = Automatic

	/// Horas del tramo dentro del horario laboral de la mesa (L-V 6:00-23:00, Sáb 9:00-19:00). Ver función HorasLaborales.
	column 'Horas Hábiles'
		dataType: double
		formatString: #,##0.00
		lineageTag: 1b2c3d4e-5f60-4b7c-9d8e-0f1a2b3c4d5e
		summarizeBy: none
		sourceColumn: Horas Hábiles

		annotation SummarizationSetBy = Automatic

	/// Agrupa el estado para la línea de tiempo, solo para "Proyecto Internet en Parques (IEP)": N1 (Nueva solicitud, N1, Reabierta), N2 RAM, N2 QCOM, y "Otro" para el resto (Planta externa, Escalado y variantes, esperas, etc.). Vacío solo para el otro flujo.
	column 'Grupo N1 N2' =
			IF(
			    FactStatusHistory[Flujo] = "Proyecto Internet en Parques (IEP)",
			    SWITCH(
			        TRUE(),
			        FactStatusHistory[Estado] IN {"Nueva solicitud", "N1", "Reabierta"}, "N1",
			        FactStatusHistory[Estado] = "N2 RAM", "N2 RAM",
			        FactStatusHistory[Estado] = "N2 QCOM", "N2 QCOM",
			        "Otro"
			    )
			)
		dataType: string
		lineageTag: 5f607182-93a4-4b5c-8d6e-7f8091a2b3c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Orden del estado en el flujo, para ordenar ejes y tablas. Se define en la lista OrdenEstados de la consulta.
	/// Nombre del estado tal como viene de Jira (antes de normalizar inglés -> español).
	column 'Estado Jira'
		dataType: string
		lineageTag: 1ff42426-36a7-4979-8190-801042483626
		summarizeBy: none
		sourceColumn: Estado Jira

		annotation SummarizationSetBy = Automatic

	/// TRUE si el estado (ya pasado a su equivalente actual) existe hoy en algún flujo; FALSE si no tiene equivalente.
	column Vigente
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 979f28bf-e1b2-4516-bc75-09fbc5e96db3
		summarizeBy: none
		sourceColumn: Vigente

		annotation SummarizationSetBy = Automatic

	partition FactStatusHistory = m
		mode: import
		source =
				let
				
				    JiraBaseUrl = "https://secureopsmx.atlassian.net",
				    Issues = Jira_MDSC_Issues,
				
				    // Orden de los estados de ambos tipos de servicio (Proyecto Internet en Parques (IEP) y Mesa de Servicio).
				    // Un estado que no esté aquí se ordena al final.
				    OrdenEstados = {
				        "Nueva solicitud", "Reabierta", "N1", "En curso", "N2 RAM", "N2 QCOM",
				        "Escalado a N2", "Escalado", "Escalado a N3", "Escalado QCOM",
				        "N3 RAM", "Esperando al proveedor", "Esperando por el cliente", "Planta externa", "Resuelta", "Cerrada"
				    },
				
				
				    // ========================================
				    // AYUDANTES
				    // ========================================
				
				    // Jira devuelve fechas con zona ("-0600"); se pasan a hora de Mérida (UTC-6, sin horario de verano)
				    ToLocal = (t as nullable text) as nullable datetime =>
				        if t = null then null
				        else
				            let
				                Len = Text.Length(t),
				                Iso =
				                    if Len > 5 and List.Contains({"+", "-"}, Text.At(t, Len - 5))
				                    then Text.Insert(t, Len - 2, ":")
				                    else t
				            in
				                DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(Iso), -6)),
				
				    Now = DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), -6)),
				
				    NameOf = (r as any, f as text) as any =>
				        if r is record then Record.FieldOrDefault(r, f, null) else null,
				
				
				    // ========================================
				    // ESTADOS VIGENTES POR FLUJO
				    // ========================================
				
				    // Estados que tiene HOY cada tipo de ticket en Jira. Los tramos en estados que ya no
				    // existen en el flujo del ticket (flujos anteriores) se descartan.
				    ProjectStatuses =
				        Json.Document(
				            Web.Contents(
				                JiraBaseUrl,
				                [
				                    RelativePath = "rest/api/3/project/MDSC/statuses",
				                    Headers = [Accept = "application/json"]
				                ]
				            )
				        ),
				
				    FlujoDe = (IssueType as nullable text) as text =>
				        if IssueType = "IEP INCIDENT" then "Proyecto Internet en Parques (IEP)" else "Mesa de Servicio",
				
				    Vigentes =
				        Table.Distinct(
				            Table.FromRecords(
				                List.Combine(
				                    List.Transform(
				                        ProjectStatuses,
				                        (t) =>
				                            List.Transform(
				                                t[statuses],
				                                (s) => [
				                                    Flujo = FlujoDe(t[name]),
				                                    EstadoId = Text.From(s[id]),
				                                    EstadoNombre = s[name],
				                                    CategoriaNombre = s[statusCategory][name],
				                                    CategoriaKey = s[statusCategory][key]
				                                ]
				                            )
				                    )
				                ),
				                type table [Flujo = text, EstadoId = text, EstadoNombre = text, CategoriaNombre = text, CategoriaKey = text]
				            ),
				            {"Flujo", "EstadoId"}
				        ),
				
				
				    // ========================================
				    // TRAMOS POR TICKET
				    // ========================================
				
				    // El estado se identifica por ID (el nombre del historial puede venir en otro idioma o con un nombre anterior)
				    Segments = (i as record) as list =>
				        let
				            f = i[fields],
				            FlujoTicket = FlujoDe(NameOf(Record.FieldOrDefault(f, "issuetype", null), "name")),
				            CreatedAt = ToLocal(f[created]),
				            CurrentStatus = Record.FieldOrDefault(f, "status", null),
				            Changes =
				                List.Sort(
				                    List.Combine(
				                        List.Transform(
				                            i[histories],
				                            (h) =>
				                                List.Transform(
				                                    List.Select(h[items], each Record.FieldOrDefault(_, "field", null) = "status"),
				                                    (it) => [
				                                        At = ToLocal(h[created]),
				                                        FromId = Text.From(Record.FieldOrDefault(it, "from", null)),
				                                        ToId = Text.From(Record.FieldOrDefault(it, "to", null)),
				                                        FromName = Record.FieldOrDefault(it, "fromString", null),
				                                        ToName = Record.FieldOrDefault(it, "toString", null)
				                                    ]
				                                )
				                        )
				                    ),
				                    (a, b) => Value.Compare(a[At], b[At])
				                ),
				            InitialId =
				                if List.IsEmpty(Changes)
				                then Text.From(NameOf(CurrentStatus, "id"))
				                else Changes{0}[FromId],
				            InitialName =
				                if List.IsEmpty(Changes)
				                then NameOf(CurrentStatus, "name")
				                else Changes{0}[FromName],
				            Starts =
				                {[IdTramo = InitialId, NombreTramo = InitialName, InicioTramo = CreatedAt]}
				                & List.Transform(Changes, each [IdTramo = [ToId], NombreTramo = [ToName], InicioTramo = [At]]),
				            Total = List.Count(Starts)
				        in
				            List.Transform(
				                {0 .. Total - 1},
				                (n) =>
				                    let
				                        s = Starts{n},
				                        IsLast = n = Total - 1,
				                        FinTramo = if IsLast then Now else Starts{n + 1}[InicioTramo]
				                    in
				                        [
				                            Key = i[key],
				                            Flujo = FlujoTicket,
				                            EstadoId = s[IdTramo],
				                            EstadoHistorial = s[NombreTramo],
				                            Visita = n + 1,
				                            Inicio = s[InicioTramo],
				                            Fin = FinTramo,
				                            Horas = Duration.TotalHours(FinTramo - s[InicioTramo]),
				                            #"Horas Hábiles" = HorasLaborales(s[InicioTramo], FinTramo),
				                            #"Es Actual" = IsLast,
				                            #"Hora Inicio" = Duration.TotalHours(s[InicioTramo] - CreatedAt),
				                            #"Hora Fin" = Duration.TotalHours(FinTramo - CreatedAt)
				                        ]
				            ),
				
				    Base =
				        Table.FromRecords(
				            List.Combine(List.Transform(Issues, Segments)),
				            type table [
				                Key = text,
				                Flujo = text,
				                EstadoId = nullable text,
				                EstadoHistorial = nullable text,
				                Visita = Int64.Type,
				                Inicio = datetime,
				                Fin = datetime,
				                Horas = number,
				                #"Horas Hábiles" = number,
				                #"Es Actual" = logical,
				                #"Hora Inicio" = number,
				                #"Hora Fin" = number
				            ]
				        ),
				
				    // Unión izquierda: se conservan TODOS los tramos (el SLA necesita el tiempo completo del ticket).
				    // Los estados que ya no existen en el flujo se pasan al estado actual que los representa (ver Normaliza).
				    // Table.Buffer: los tramos (y sus horas laborales) se calculan una sola vez antes de la unión
				    Joined = Table.NestedJoin(Table.Buffer(Base), {"Flujo", "EstadoId"}, Vigentes, {"Flujo", "EstadoId"}, "Vig", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Vig", {"EstadoNombre", "CategoriaNombre", "CategoriaKey"}),
				
				    // Nombre del estado actual que representa a cada nombre de Jira: inglés -> español y estados de flujos
				    // anteriores -> su equivalente de hoy (su tiempo se mide en ese estado). Se compara en minúsculas.
				    Normaliza = (n as nullable text) as nullable text =>
				        let
				            Mapa = [
				                // inicio del ticket
				                #"open" = "Nueva solicitud", #"abierto" = "Nueva solicitud", #"abierta" = "Nueva solicitud",
				                #"abiertos" = "Nueva solicitud", #"nuevo" = "Nueva solicitud", #"nueva" = "Nueva solicitud",
				                #"new" = "Nueva solicitud", #"to do" = "Nueva solicitud", #"por hacer" = "Nueva solicitud",
				                #"waiting for support" = "Nueva solicitud", #"esperando soporte" = "Nueva solicitud", #"esperando por ayuda" = "Nueva solicitud",
				                // atención de primer nivel
				                #"in progress" = "N1", #"en curso" = "N1", #"trabajo en curso" = "N1", #"en progreso" = "N1",
				                #"pendiente" = "N1", #"pending" = "N1", #"n1 qcom" = "N1", #"n1 ram" = "N1",
				                // segundo y tercer nivel
				                #"escalado a n2" = "N2 RAM", #"n2" = "N2 RAM",
				                #"escalado a n3" = "N3 RAM", #"n3" = "N3 RAM",
				                // espera, escalamiento, reapertura y cierre
				                #"waiting for customer" = "Esperando por el cliente", #"esperando al solicitante" = "Esperando por el cliente",
				                #"escalated" = "Escalado",
				                #"resolved" = "Resuelta", #"resuelto" = "Resuelta", #"completado" = "Resuelta", #"completada" = "Resuelta", #"completed" = "Resuelta",
				                #"reopened" = "Reabierta",
				                #"closed" = "Cerrada"
				            ]
				        in
				            if n = null then null else Record.FieldOrDefault(Mapa, Text.Lower(Text.Trim(n)), Text.Trim(n)),
				
				    // Nombres de los estados que existen hoy en algún flujo
				    Actuales = List.Buffer(List.Distinct(Vigentes[EstadoNombre])),
				
				    WithJira = Table.AddColumn(Expanded, "Estado Jira", each [EstadoNombre] ?? [EstadoHistorial] ?? "Sin estado", type text),
				    WithEstado =
				        Table.AddColumn(
				            WithJira,
				            "Estado",
				            each
				                let
				                    e = Normaliza([#"Estado Jira"])
				                in
				                    // cualquier estado inicial (primer tramo) de un flujo anterior, salvo Reabierta, es Nueva solicitud
				                    if [Visita] = 1 and not List.Contains(Actuales, e) and e <> "Reabierta" then "Nueva solicitud" else e,
				            type text
				        ),
				    // TRUE si el estado (ya normalizado) existe hoy en algún flujo; los que no tienen equivalente quedan en FALSE
				    WithVigente = Table.AddColumn(WithEstado, "Vigente", each List.Contains(Actuales, [Estado]), type logical),
				
				    WithOrden =
				        Table.AddColumn(
				            WithVigente,
				            "Orden Estado",
				            each
				                let
				                    Posicion = List.PositionOf(OrdenEstados, [Estado])
				                in
				                    if Posicion < 0 then 99 else Posicion + 1,
				            Int64.Type
				        ),
				
				    WithCategory = Table.AddColumn(WithOrden, "Categoría Estado", each [CategoriaNombre] ?? "Estado anterior", type text),
				
				    WithFinal =
				        Table.AddColumn(
				            WithCategory,
				            "Es Estado Final",
				            each if [CategoriaKey] = null then List.Contains({"Resuelta", "Cerrada"}, [Estado]) else [CategoriaKey] = "done",
				            type logical
				        ),
				
				    Result =
				        Table.SelectColumns(
				            WithFinal,
				            {
				                "Key", "Flujo", "Estado", "Estado Jira", "Vigente", "Orden Estado", "Categoría Estado", "Es Estado Final",
				                "Visita", "Inicio", "Fin", "Horas", "Horas Hábiles", "Es Actual", "Hora Inicio", "Hora Fin"
				            }
				        )
								in
				    Result

	annotation PBI_ResultType = Table


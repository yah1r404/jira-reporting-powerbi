		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 632fc5ee-2f0b-47c6-bfce-dd0cbff6077d
		summarizeBy: none
		sourceColumn: JSM Respuesta Meta Horas

		annotation SummarizationSetBy = Automatic


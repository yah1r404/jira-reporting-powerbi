	column 'JSM Respuesta Horas'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 3fc2e1a5-2400-4670-9603-7d48c565e660
		summarizeBy: none
		sourceColumn: JSM Respuesta Horas

		annotation SummarizationSetBy = Automatic

	/// Cumplido / Incumplido / En curso / En riesgo (queda 25% o menos) / Sin SLA.
	column 'JSM Respuesta Estado'
		dataType: string
		isHidden
		lineageTag: e10e3e97-23ac-45a4-8f85-9c9606751598

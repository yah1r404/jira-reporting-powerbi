	column 'Técnicos Asignados'
		dataType: string
		lineageTag: bedccfe9-80f8-4fb5-96bc-b6b4e549abd8
		summarizeBy: none
		sourceColumn: Técnicos Asignados

		annotation SummarizationSetBy = Automatic

	partition Jira_Tickets = m
		mode: import
		source =
				let

				    // ========================================
				    // FUENTE COMPARTIDA
				    // ========================================

				    // Mismo alcance que el tablero de SLA: se reutiliza Jira_MDSC_Issues (una sola llamada a la
				    // API para toda la mesa MDSC) en vez de volver a consultar Jira con el mismo JQL. Esta tabla
				    // no usa el changelog que trae Jira_MDSC_Issues, solo los campos planos del ticket.
				    Issues = Jira_MDSC_Issues,

				    NameOf = (r as any, f as text) as any =>
				        if r is record then Record.FieldOrDefault(r, f, null) else null,


				    // ========================================
				    // UN RENGLÓN POR TICKET
				    // ========================================

				    Rows =
				        List.Transform(
				            Issues,
				            (i) =>
				                let
				                    f = i[fields],
				                    AssigneeRec = Record.FieldOrDefault(f, "assignee", null),
				                    ReporterRec = Record.FieldOrDefault(f, "reporter", null),
				                    ProjectRec = Record.FieldOrDefault(f, "project", null),
				                    LabelsList = Record.FieldOrDefault(f, "labels", null),
				                    TecnicosList = Record.FieldOrDefault(f, "customfield_11042", null)
				                in
				                    [
				                        #"Issue ID" = i[id],
				                        Key = i[key],
				                        Summary = Record.FieldOrDefault(f, "summary", null),
				                        Status = NameOf(Record.FieldOrDefault(f, "status", null), "name"),
				                        Assignee = NameOf(AssigneeRec, "displayName"),
				                        #"Assignee Account ID" = NameOf(AssigneeRec, "accountId"),
				                        Reporter = NameOf(ReporterRec, "displayName"),
				                        #"Reporter Account ID" = NameOf(ReporterRec, "accountId"),
				                        Created = f[created],
				                        Updated = Record.FieldOrDefault(f, "updated", null),
				                        #"Resolution Date" = Record.FieldOrDefault(f, "resolutiondate", null),
				                        Priority = NameOf(Record.FieldOrDefault(f, "priority", null), "name"),
				                        #"Issue Type" = NameOf(Record.FieldOrDefault(f, "issuetype", null), "name"),
				                        #"Project Key" = NameOf(ProjectRec, "key"),
				                        Project = NameOf(ProjectRec, "name"),
				                        Labels =
				                            if LabelsList is list
				                            then Text.Combine(List.Transform(LabelsList, Text.From), ", ")
				                            else null,
				                        #"Técnicos Asignados" =
				                            if TecnicosList is list
				                            then Text.Combine(List.Transform(TecnicosList, each NameOf(_, "displayName")), ", ")
				                            else null
				                    ]
				        ),

				    CleanTecnicos =
				        Table.FromRecords(
				            Rows,
				            type table [
				                #"Issue ID" = text,
				                Key = text,
				                Summary = nullable text,
				                Status = nullable text,
				                Assignee = nullable text,
				                #"Assignee Account ID" = nullable text,
				                Reporter = nullable text,
				                #"Reporter Account ID" = nullable text,
				                Created = text,
				                Updated = nullable text,
				                #"Resolution Date" = nullable text,
				                Priority = nullable text,
				                #"Issue Type" = nullable text,
				                #"Project Key" = nullable text,
				                Project = nullable text,
				                Labels = nullable text,
				                #"Técnicos Asignados" = nullable text
				            ]
				        ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(CleanTecnicos,{{"Reporter", type text}, {"Assignee", type text}, {"Status", type text}}),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Tipo cambiado",{{"Created", type datetimezone}, {"Updated", type datetimezone}, {"Resolution Date", type datetimezone}, {"Priority", type text}, {"Issue Type", type text}, {"Project Key", type text}, {"Project", type text}, {"Reporter Account ID", type text}, {"Assignee Account ID", type text}, {"Summary", type text}, {"Key", type text}, {"Issue ID", type text}, {"Técnicos Asignados", type text}}),
				    #"Personalizada agregada" = Table.AddColumn(#"Tipo cambiado1", "Created Date", each Date.From([Created])),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Created Date", type date}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado2", "Resolution Date Only", each if [Resolution Date] = null
				then null
				else Date.From([Resolution Date])),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Personalizada agregada1",{{"Resolution Date Only", type date}}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Tipo cambiado3", "Resolution Hours", each if [Resolution Date] = null
				then null
				else Duration.TotalHours([Resolution Date] - [Created])),
				    #"Tipo cambiado4" = Table.TransformColumnTypes(#"Personalizada agregada2",{{"Resolution Hours", type number}})
				in
				    #"Tipo cambiado4"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table


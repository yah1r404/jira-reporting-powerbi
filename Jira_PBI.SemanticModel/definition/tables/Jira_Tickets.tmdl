	column 'Jira Link' = "https://secureopsmx.atlassian.net/browse/" & 'Jira_Tickets'[Key]
		dataType: string
		lineageTag: 0d3a7823-e9e8-407f-933b-39fd88dc4453
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Técnicos Asignados'
		dataType: string
		lineageTag: bedccfe9-80f8-4fb5-96bc-b6b4e549abd8
		summarizeBy: none
		sourceColumn: Técnicos Asignados

		annotation SummarizationSetBy = Automatic

	partition Jira_Tickets = m
		mode: import
		source =
				let
				
				    // ========================================
				    // CONFIGURACIÓN
				    // ========================================
				
				    JiraBaseUrl = "https://secureopsmx.atlassian.net",
				
				    // Mismo alcance que el tablero de SLA (Jira_MDSC_Issues): mesa MDSC, últimos 6 meses,
				    // sin Emailed request ni tickets en estado Cerrada (en JQL: Closed). No depende de filtros guardados.
				    JQL = "project = MDSC AND issuetype != ""Emailed request"" AND status != Closed AND created >= startOfMonth(-5) ORDER BY created ASC",
				
				
				    // ========================================
				    // CAMPOS QUE QUEREMOS
				    // ========================================
				
				    JiraFields =
				        "summary,status,assignee,reporter,created,updated,resolutiondate,priority,issuetype,project,labels,customfield_11042",
				
				
				    // ========================================
				    // OBTENER UNA PÁGINA
				    // ========================================
				
				    GetPage = (NextToken as nullable text) as record =>
				
				        let
				
				            BaseQuery = [
				                jql = JQL,
				                maxResults = "100",
				                fields = JiraFields
				            ],
				
				            RequestQuery =
				                if NextToken = null
				                then BaseQuery
				                else
				                    Record.AddField(
				                        BaseQuery,
				                        "nextPageToken",
				                        NextToken
				                    ),
				
				            Response =
				                Json.Document(
				                    Web.Contents(
				                        JiraBaseUrl,
				                        [
				                            RelativePath =
				                                "rest/api/3/search/jql",
				
				                            Query = RequestQuery,
				
				                            Headers = [
				                                Accept = "application/json"
				                            ]
				                        ]
				                    )
				                )
				
				        in
				            Response,
				
				
				    // ========================================
				    // PAGINACIÓN
				    // ========================================
				
				    Pages =
				        List.Generate(
				            () => GetPage(null),
				
				            each _ <> null,
				
				            each
				                let
				                    Token =
				                        try [nextPageToken]
				                        otherwise null
				                in
				                    if Token = null
				                    then null
				                    else GetPage(Token),
				
				            each [issues]
				        ),
				
				
				    Issues =
				        List.Combine(Pages),
				
				
				    // ========================================
				    // JSON → TABLA
				    // ========================================
				
				    IssueTable =
				        Table.FromList(
				            Issues,
				            Splitter.SplitByNothing(),
				            {"Issue"}
				        ),
				
				
				    ExpandIssue =
				        Table.ExpandRecordColumn(
				            IssueTable,
				            "Issue",
				            {
				                "id",
				                "key",
				                "fields"
				            },
				            {
				                "Issue ID",
				                "Key",
				                "Fields"
				            }
				        ),
				
				
				    ExpandFields =
				        Table.ExpandRecordColumn(
				            ExpandIssue,
				            "Fields",
				            {
				                "summary",
				                "status",
				                "assignee",
				                "reporter",
				                "created",
				                "updated",
				                "resolutiondate",
				                "priority",
				                "issuetype",
				                "project",
				                "labels",
				                "customfield_11042"
				            },
				            {
				                "Summary",
				                "Status Record",
				                "Assignee Record",
				                "Reporter Record",
				                "Created",
				                "Updated",
				                "Resolution Date",
				                "Priority Record",
				                "Issue Type Record",
				                "Project Record",
				                "Labels",
				                "Técnicos Asignados"
				            }
				        ),
				
				
				    ExpandStatus =
				        Table.ExpandRecordColumn(
				            ExpandFields,
				            "Status Record",
				            {"name"},
				            {"Status"}
				        ),
				
				
				    ExpandAssignee =
				        Table.ExpandRecordColumn(
				            ExpandStatus,
				            "Assignee Record",
				            {
				                "displayName",
				                "accountId"
				            },
				            {
				                "Assignee",
				                "Assignee Account ID"
				            }
				        ),
				
				
				    ExpandReporter =
				        Table.ExpandRecordColumn(
				            ExpandAssignee,
				            "Reporter Record",
				            {
				                "displayName",
				                "accountId"
				            },
				            {
				                "Reporter",
				                "Reporter Account ID"
				            }
				        ),
				
				
				    ExpandPriority =
				        Table.ExpandRecordColumn(
				            ExpandReporter,
				            "Priority Record",
				            {"name"},
				            {"Priority"}
				        ),
				
				
				    ExpandIssueType =
				        Table.ExpandRecordColumn(
				            ExpandPriority,
				            "Issue Type Record",
				            {"name"},
				            {"Issue Type"}
				        ),
				
				
				    ExpandProject =
				        Table.ExpandRecordColumn(
				            ExpandIssueType,
				            "Project Record",
				            {
				                "key",
				                "name"
				            },
				            {
				                "Project Key",
				                "Project"
				            }
				        ),
				
				
				    CleanLabels =
				        Table.TransformColumns(
				            ExpandProject,
				            {
				                {
				                    "Labels",
				                    each
				                        if _ is list
				                        then Text.Combine(
				                            List.Transform(_, Text.From),
				                            ", "
				                        )
				                        else null,
				                    type text
				                }
				            }
				        ),
				    CleanTecnicos =
				        Table.TransformColumns(
				            CleanLabels,
				            {
				                {
				                    "Técnicos Asignados",
				                    each
				                        if _ is list
				                        then Text.Combine(
				                            List.Transform(_, each Record.Field(_, "displayName")),
				                            ", "
				                        )
				                        else null,
				                    type text
				                }
				            }
				        ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(CleanTecnicos,{{"Reporter", type text}, {"Assignee", type text}, {"Status", type text}}),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Tipo cambiado",{{"Created", type datetimezone}, {"Updated", type datetimezone}, {"Resolution Date", type datetimezone}, {"Priority", type text}, {"Issue Type", type text}, {"Project Key", type text}, {"Project", type text}, {"Reporter Account ID", type text}, {"Assignee Account ID", type text}, {"Summary", type text}, {"Key", type text}, {"Issue ID", type text}, {"Técnicos Asignados", type text}}),
				    #"Personalizada agregada" = Table.AddColumn(#"Tipo cambiado1", "Created Date", each Date.From([Created])),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Created Date", type date}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado2", "Resolution Date Only", each if [Resolution Date] = null
				then null
				else Date.From([Resolution Date])),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Personalizada agregada1",{{"Resolution Date Only", type date}}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Tipo cambiado3", "Resolution Hours", each if [Resolution Date] = null
				then null
				else Duration.TotalHours([Resolution Date] - [Created])),
				    #"Tipo cambiado4" = Table.TransformColumnTypes(#"Personalizada agregada2",{{"Resolution Hours", type number}})
				in
				    #"Tipo cambiado4"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table


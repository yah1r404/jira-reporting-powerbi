model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["_Medidas","Jira_MDSC_Issues","Jira_MDSC_Issues_Staging","SLA_Tickets","FactStatusHistory","FactAssigneeHistory","HorasLaborales","FactTecnicos"]

ref table DimFecha
ref table _Medidas
ref table Jira_MDSC_Issues_Staging
ref table SLA_Tickets
ref table FactStatusHistory
ref table FactAssigneeHistory
ref table 'SLA Objetivo'
ref table 'Línea de Tiempo'
ref table 'Horario Cálculo'
ref table FactTecnicos

ref cultureInfo es-MX


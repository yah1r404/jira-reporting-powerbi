table DimFecha
	lineageTag: 8d9e0f1a-2b3c-4d4e-5f6a-7b8c9d0e1f2a
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 9e0f1a2b-3c4d-4e5f-6a7b-8c9d0e1f2a3b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Año = YEAR([Date])
		dataType: int64
		formatString: 0
		lineageTag: 0f1a2b3c-4d5e-4f6a-7b8c-9d0e1f2a3b4c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Trimestre = "T" & Text.From(QUARTER([Date]))
		dataType: string
		lineageTag: 1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5e
		summarizeBy: none
		sortByColumn: 'Trimestre Numero'

		annotation SummarizationSetBy = Automatic

	column 'Trimestre Numero' = QUARTER([Date])
		dataType: int64
		formatString: 0
		lineageTag: 2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6f
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Año Trimestre' = Text.From(YEAR([Date])) & "-" & "T" & Text.From(QUARTER([Date]))
		dataType: string
		lineageTag: 3c4d5e6f-7a8b-4c9d-0e1f-2a3b4c5d6e70
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mes Numero' = MONTH([Date])
		dataType: int64
		formatString: 0
		lineageTag: 4d5e6f7a-8b9c-4d0e-1f2a-3b4c5d6e7f81
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = Automatic

	column Mes = FORMAT([Date], "mmmm")
		dataType: string
		lineageTag: 5e6f7a8b-9c0d-4e1f-2a3b-4c5d6e7f8a92
		summarizeBy: none
		sortByColumn: 'Mes Numero'

		annotation SummarizationSetBy = Automatic

	column 'Año Mes' = FORMAT([Date], "yyyy-mm")
		dataType: string
		lineageTag: 6f7a8b9c-0d1e-4f2a-3b4c-5d6e7f8a9b03
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Día = DAY([Date])
		dataType: int64
		formatString: 0
		lineageTag: 7a8b9c0d-1e2f-4a3b-4c5d-6e7f8a9b0c14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Día Semana Numero' = WEEKDAY([Date], 2)
		dataType: int64
		formatString: 0
		lineageTag: 8b9c0d1e-2f3a-4b4c-5d6e-7f8a9b0c1d25
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = Automatic

	column 'Día Semana' = FORMAT([Date], "dddd")
		dataType: string
		lineageTag: 9c0d1e2f-3a4b-4c5d-6e7f-8a9b0c1d2e36
		summarizeBy: none
		sortByColumn: 'Día Semana Numero'

		annotation SummarizationSetBy = Automatic

	/// Semana del año de creación (lunes a domingo), ej. 2026-S42.
	column Semana = YEAR([Date]) & "-S" & FORMAT(WEEKNUM([Date], 2), "00")
		dataType: string
		lineageTag: 0d1e2f3a-4b5c-4d6e-7f8a-9b0c1d2e3f47
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimFecha = calculated
		mode: import
		source = CALENDAR(MIN(FactTickets[Fecha Creación]), MAX(MAX(FactTickets[Fecha Creación]), TODAY()))

	annotation PBI_Id = DimFecha_CalendarioPrincipal

/// Tabla de 1 fila con la marca de tiempo del refresh, para mostrar "Última actualización" en el tablero (página de Calidad y cobertura).
table Actualizacion
	lineageTag: 5a6b7c8d-9e0f-4a1b-2c3d-4e5f6a7b8c9f

	column 'Última Actualización'
		dataType: dateTime
		formatString: General Date
		lineageTag: 6b7c8d9e-0f1a-4b2c-3d4e-5f6a7b8c9d00
		summarizeBy: none
		sourceColumn: Última Actualización

		annotation SummarizationSetBy = Automatic

	partition Actualizacion = m
		mode: import
		source =
				#table(
				    {"Última Actualización"},
				    {{DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FixedLocalNow(), -6))}}
				)

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

		lineageTag: 4d5e6f7a-8b9c-4d0e-1f2a-3b4c5d6e7f8a
		summarizeBy: none
		sourceColumn: Issue ID

		annotation SummarizationSetBy = Automatic

	/// Mesa normalizada (regla documentada en la partición: MesaMap). "Sin clasificar" si la clave de proyecto no corresponde a ninguna de las 7 mesas conocidas.
	column Mesa

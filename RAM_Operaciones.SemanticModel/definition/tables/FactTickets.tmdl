		lineageTag: 7a8b9c0d-1e2f-4a3b-4c5d-6e7f8a9b0c1d
		summarizeBy: none
		sourceColumn: Proyecto Nombre

		annotation SummarizationSetBy = Automatic

	column Summary
		dataType: string
		lineageTag: 8b9c0d1e-2f3a-4b4c-5d6e-7f8a9b0c1d2e
		summarizeBy: none
		sourceColumn: Summary

		annotation SummarizationSetBy = Automatic

	/// Tipo de incidencia de Jira (issuetype). Distinto del tipo de solicitud del portal; no se mezclan.
	column 'Tipo de Incidencia'
		dataType: string
		lineageTag: 9c0d1e2f-3a4b-4c5d-6e7f-8a9b0c1d2e3f
		summarizeBy: none
		sourceColumn: Tipo de Incidencia

		annotation SummarizationSetBy = Automatic

	/// Tipo de solicitud del portal (customfield_10010). "Sin request type" cuando el campo viene vacío: puede ser porque

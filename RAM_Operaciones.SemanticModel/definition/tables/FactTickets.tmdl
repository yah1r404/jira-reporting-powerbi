	column 'Tipo de Solicitud'
		dataType: string
		lineageTag: 0d1e2f3a-4b5c-4d6e-7f8a-9b0c1d2e3f4a
		summarizeBy: none
		sourceColumn: Tipo de Solicitud

		annotation SummarizationSetBy = Automatic

	column Estado
		dataType: string
		lineageTag: 1e2f3a4b-5c6d-4e7f-8a9b-0c1d2e3f4a5b

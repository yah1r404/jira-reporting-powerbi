		summarizeBy: average
		sourceColumn: Horas Resolución

		annotation SummarizationSetBy = Automatic

	/// FALSE si Mesa = "Sin clasificar" (la clave de proyecto no se reconoció). Debe ser siempre TRUE con el JQL actual; queda como control de calidad.
	column 'Es Clasificado'
		dataType: boolean
		formatString: """Sí"";""Sí"";""No"""
		lineageTag: 1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f
		summarizeBy: none
		sourceColumn: Es Clasificado

		annotation SummarizationSetBy = Automatic

	/// TRUE si la categoría del estado actual no es "Cerrado" (inventario abierto/pendiente).
	column 'Está Abierto'
		dataType: boolean
		formatString: """Sí"";""Sí"";""No"""
		lineageTag: 2d3e4f5a-6b7c-4d8e-9f0a-1b2c3d4e5f6a
		summarizeBy: none
		sourceColumn: Está Abierto

		annotation SummarizationSetBy = Automatic

	partition FactTickets = m
		mode: import
		source =
				let

				    Issues = RAM_Issues,


				    // ========================================
				    // CLASIFICACIÓN DE MESA (regla única en MesaMap, compartida con DimMesa)
				    // ========================================

				    MesaDe = (ClaveProyecto as nullable text) as text =>
				        let
				            Match = List.Select(MesaMap, each [Clave] = ClaveProyecto)
				        in
				            if List.IsEmpty(Match) then "Sin clasificar" else Match{0}[Mesa],


				    // ========================================
				    // AYUDANTES
				    // ========================================

				    // Jira devuelve fechas con zona ("-0600"); se pasan a hora de Mérida (UTC-6, sin horario de verano)
				    ToLocal = (t as nullable text) as nullable datetime =>
				        if t = null then null
				        else
				            let
				                Len = Text.Length(t),
				                Iso =
				                    if Len > 5 and List.Contains({"+", "-"}, Text.At(t, Len - 5))
				                    then Text.Insert(t, Len - 2, ":")
				                    else t
				            in
				                DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(Iso), -6)),

				    NameOf = (r as any, f as text) as any =>
				        if r is record then Record.FieldOrDefault(r, f, null) else null,

				    // Normaliza statusCategory.key (independiente del idioma): new / indeterminate / done
				    CategoriaDe = (StatusRec as any) as text =>
				        let
				            CatKey = NameOf(NameOf(StatusRec, "statusCategory"), "key")
				        in
				            if CatKey = "done" then "Cerrado"
				            else if CatKey = "indeterminate" then "En curso"
				            else if CatKey = "new" then "Nuevo"
				            else "Sin categoría",


				    // ========================================
				    // UN RENGLÓN POR TICKET
				    // ========================================

				    Rows =
				        List.Transform(
				            Issues,
				            (i) =>
				                let
				                    f = i[fields],
				                    ProjectRec = Record.FieldOrDefault(f, "project", null),
				                    ClaveProyecto = NameOf(ProjectRec, "key"),
				                    StatusRec = Record.FieldOrDefault(f, "status", null),
				                    AssigneeName = NameOf(Record.FieldOrDefault(f, "assignee", null), "displayName"),
				                    ReporterName = NameOf(Record.FieldOrDefault(f, "reporter", null), "displayName"),
				                    RequestType =
				                        NameOf(
				                            NameOf(Record.FieldOrDefault(f, "customfield_10010", null), "requestType"),
				                            "name"
				                        ),
				                    CreatedAt = ToLocal(f[created]),
				                    UpdatedAt = ToLocal(Record.FieldOrDefault(f, "updated", null)),
				                    ResolvedAt = ToLocal(Record.FieldOrDefault(f, "resolutiondate", null)),
				                    Categoria = CategoriaDe(StatusRec)
				                in
				                    [
				                        Key = i[key],
				                        #"Issue ID" = Text.From(i[id]),
				                        Mesa = MesaDe(ClaveProyecto),
				                        #"Proyecto Clave" = if ClaveProyecto = null then "Desconocido" else ClaveProyecto,
				                        #"Proyecto Nombre" = if NameOf(ProjectRec, "name") = null then "Desconocido" else NameOf(ProjectRec, "name"),
				                        Summary = Record.FieldOrDefault(f, "summary", null),
				                        #"Tipo de Incidencia" = NameOf(Record.FieldOrDefault(f, "issuetype", null), "name"),
				                        #"Tipo de Solicitud" = if RequestType = null then "Sin request type" else RequestType,
				                        Estado = NameOf(StatusRec, "name"),
				                        #"Categoría Estado" = Categoria,
				                        Prioridad = NameOf(Record.FieldOrDefault(f, "priority", null), "name"),
				                        Asignado = if AssigneeName = null then "Sin asignar" else AssigneeName,
				                        Solicitante = if ReporterName = null then "Sin solicitante" else ReporterName,
				                        Creado = CreatedAt,
				                        #"Fecha Creación" = if CreatedAt = null then null else DateTime.From(Date.From(CreatedAt)),
				                        Actualizado = UpdatedAt,
				                        Resuelto = ResolvedAt,
				                        #"Horas Resolución" = if ResolvedAt = null or CreatedAt = null then null else Duration.TotalHours(ResolvedAt - CreatedAt),
				                        #"Es Clasificado" = MesaDe(ClaveProyecto) <> "Sin clasificar",
				                        #"Está Abierto" = Categoria <> "Cerrado"
				                    ]
				        ),

				    Tickets =
				        Table.FromRecords(
				            Rows,
				            type table [
				                Key = text,
				                #"Issue ID" = text,
				                Mesa = text,
				                #"Proyecto Clave" = text,
				                #"Proyecto Nombre" = text,
				                Summary = nullable text,
				                #"Tipo de Incidencia" = nullable text,
				                #"Tipo de Solicitud" = text,
				                Estado = nullable text,
				                #"Categoría Estado" = text,
				                Prioridad = nullable text,
				                Asignado = text,
				                Solicitante = text,
				                Creado = datetime,
				                #"Fecha Creación" = nullable datetime,
				                Actualizado = nullable datetime,
				                Resuelto = nullable datetime,
				                #"Horas Resolución" = nullable number,
				                #"Es Clasificado" = logical,
				                #"Está Abierto" = logical
				            ]
				        ),

				    // Quita duplicados por Key (control de calidad: un ticket no debe contarse dos veces)
				    SinDuplicados = Table.Distinct(Tickets, {"Key"})
				in
				    SinDuplicados

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

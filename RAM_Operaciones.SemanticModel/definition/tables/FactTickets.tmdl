	/// Solo la fecha de creación (sin hora), usada para relacionar con DimFecha.
	column 'Fecha Creación'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7e8f9a0b-1c2d-4e3f-4a5b-6c7d8e9f0a1b
		summarizeBy: none
		sourceColumn: Fecha Creación

		annotation SummarizationSetBy = Automatic

	column Actualizado
		dataType: dateTime
		formatString: General Date
		lineageTag: 8f9a0b1c-2d3e-4f4a-5b6c-7d8e9f0a1b2c
		summarizeBy: none
		sourceColumn: Actualizado


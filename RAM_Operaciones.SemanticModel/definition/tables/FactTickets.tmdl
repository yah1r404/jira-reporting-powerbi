		lineageTag: 3a4b5c6d-7e8f-4a9b-0c1d-2e3f4a5b6c7d
		summarizeBy: none
		sourceColumn: Prioridad

		annotation SummarizationSetBy = Automatic

	column Asignado
		dataType: string
		lineageTag: 4b5c6d7e-8f9a-4b0c-1d2e-3f4a5b6c7d8e
		summarizeBy: none
		sourceColumn: Asignado

		annotation SummarizationSetBy = Automatic

	column Solicitante
		dataType: string
		lineageTag: 5c6d7e8f-9a0b-4c1d-2e3f-4a5b6c7d8e9f
		summarizeBy: none
		sourceColumn: Solicitante


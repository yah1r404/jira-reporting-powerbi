		annotation SummarizationSetBy = Automatic

	partition IEP_Tickets = m
		mode: import
		source =
				let
				
								    Issues = Jira_IEP_Issues,
				
				
								    // ========================================
								    // AYUDANTES
								    // ========================================
				
								    // Jira devuelve fechas con zona ("-0600"); se pasan a hora de Mérida (UTC-6, sin horario de verano)
								    ToLocal = (t as nullable text) as nullable datetime =>
								        if t = null then null
								        else
								            let
								                Len = Text.Length(t),
								                Iso =
								                    if Len > 5 and List.Contains({"+", "-"}, Text.At(t, Len - 5))
								                    then Text.Insert(t, Len - 2, ":")
								                    else t
								            in
								                DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(Iso), -6)),
				
								    NameOf = (r as any, f as text) as any =>
								        if r is record then Record.FieldOrDefault(r, f, null) else null,
				
								    // Texto sin espacios sobrantes; vacío -> null
								    Limpio = (t as any) as nullable text =>
								        if t = null then null
								        else
								            let
								                s = Text.Combine(List.Select(Text.Split(Text.Trim(Text.From(t)), " "), each _ <> ""), " ")
								            in
								                if s = "" then null else s,
				
								    // Valor de un campo de opción (select / radio buttons)
								    Opcion = (v as any) as nullable text => Limpio(NameOf(v, "value")),
				
								    // Resume un campo SLA de JSM: meta, tiempo transcurrido y estado
								    SlaInfo = (v as any) as record =>
								        let
								            Ongoing = if v is record then Record.FieldOrDefault(v, "ongoingCycle", null) else null,
								            Cycles =
								                (if v is record then Record.FieldOrDefault(v, "completedCycles", {}) else {})
								                & (if Ongoing = null then {} else {Ongoing}),
								            Last = if List.IsEmpty(Cycles) then null else List.Last(Cycles),
								            Hours = (c as record, f as text) as nullable number =>
								                let
								                    d = Record.FieldOrDefault(c, f, null)
								                in
								                    if d = null then null else d[millis] / 3600000,
								            Breached =
								                List.AnyTrue(
								                    List.Transform(Cycles, each Record.FieldOrDefault(_, "breached", false) = true)
								                ),
								            Goal = if Last = null then null else Hours(Last, "goalDuration"),
								            Elapsed = if Last = null then null else Hours(Last, "elapsedTime"),
								            Remaining = if Last = null then null else Hours(Last, "remainingTime"),
								            Paused = Ongoing <> null and Record.FieldOrDefault(Ongoing, "paused", false) = true,
								            // Hora real en que se detuvo el ciclo (primera respuesta o entrada a Resuelta), según Jira
								            Completados = if v is record then Record.FieldOrDefault(v, "completedCycles", {}) else {},
								            Stop = (c as record) as nullable datetime =>
								                let
								                    s = Record.FieldOrDefault(c, "stopTime", null),
								                    ms = if s is record then Record.FieldOrDefault(s, "epochMillis", null) else null
								                in
								                    if ms = null then null
								                    else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(
								                        #datetimezone(1970, 1, 1, 0, 0, 0, 0, 0) + #duration(0, 0, 0, ms / 1000), -6)),
								            PrimerFin = if List.IsEmpty(Completados) then null else Stop(List.First(Completados)),
								            UltimoFin = if List.IsEmpty(Completados) or Ongoing <> null then null else Stop(List.Last(Completados)),
								            EstadoSla =
								                if Last = null then "Sin SLA"
								                else if Breached then "Incumplido"
								                else if Paused then "Pausado"
								                else if Ongoing = null then "Cumplido"
								                else if Goal <> null and Remaining <> null and Remaining <= Goal * 0.25 then "En riesgo"
								                else "En curso"
								        in
								            [Meta = Goal, Transcurrido = Elapsed, Estado = EstadoSla, PrimerFin = PrimerFin, UltimoFin = UltimoFin],
				
				
								    // ========================================
								    // UN RENGLÓN POR TICKET
								    // ========================================
				
								    Rows =
								        List.Transform(
								            Issues,
								            (i) =>
								                let
								                    f = i[fields],
								                    StatusRec = Record.FieldOrDefault(f, "status", null),
								                    AssigneeName = NameOf(Record.FieldOrDefault(f, "assignee", null), "displayName"),
								                    Tecnicos = Record.FieldOrDefault(f, "customfield_11042", null),
								                    Orgs = Record.FieldOrDefault(f, "customfield_10002", null),
								                    RequestType =
								                        NameOf(
								                            NameOf(Record.FieldOrDefault(f, "customfield_10010", null), "requestType"),
								                            "name"
								                        ),
								                    CausasLista =
								                        let
								                            v = Record.FieldOrDefault(f, "customfield_10897", null)
								                        in
								                            if v is list then List.Distinct(List.RemoveNulls(List.Transform(v, Opcion))) else {},
								                    AP = Limpio(Record.FieldOrDefault(f, "customfield_10256", null)),
								                    APCodigo =
								                        if AP = null or not Text.Contains(AP, " - ") then null
								                        else
								                            let
								                                c = Text.Trim(Text.BeforeDelimiter(AP, " - "))
								                            in
								                                if Text.Length(c) >= 4 and Text.Length(c) <= 8 and not Text.Contains(c, " ")
								                                then Text.Upper(c) else null,
								                    CreatedAt = ToLocal(f[created]),
								                    Resolved = ToLocal(Record.FieldOrDefault(f, "resolutiondate", null)),
								                    Respuesta = SlaInfo(Record.FieldOrDefault(f, "customfield_10936", null)),
								                    Resolucion = SlaInfo(Record.FieldOrDefault(f, "customfield_10937", null)),
								                    Vacio = (t as nullable text) as text => if t = null then "Sin dato" else t,
				                    SinClasificar = (t as nullable text) as text => if t = null then "Sin clasificar" else t
								                in
								                    [
								                        Key = i[key],
								                        #"Issue ID" = Text.From(i[id]),
								                        Summary = Record.FieldOrDefault(f, "summary", null),
								                        Status = NameOf(StatusRec, "name"),
								                        #"Status Category" = NameOf(NameOf(StatusRec, "statusCategory"), "name"),
								                        Assignee = if AssigneeName = null then "Sin asignar" else AssigneeName,
								                        #"Técnicos Asignados" =
								                            if Tecnicos is list
								                            then Text.Combine(List.Transform(Tecnicos, each NameOf(_, "displayName")), ", ")
								                            else null,
								                        #"Organización" =
								                            if Orgs is list and not List.IsEmpty(Orgs)
								                            then Text.Combine(List.Transform(Orgs, each NameOf(_, "name")), ", ")
								                            else "Sin organización",
								                        #"Request Type" = Vacio(RequestType),
								                        #"Tipo de Ticket" = Vacio(Opcion(Record.FieldOrDefault(f, "customfield_10894", null))),
								                        ISP = Vacio(Opcion(Record.FieldOrDefault(f, "customfield_10323", null))),
								                        #"Tipo de Incidente" = SinClasificar(Opcion(Record.FieldOrDefault(f, "customfield_10896", null))),
								                        Causas = if List.IsEmpty(CausasLista) then "Sin clasificar" else Text.Combine(CausasLista, ", "),
								                        #"Causas Ruta" = if List.IsEmpty(CausasLista) then null else Text.Combine(CausasLista, "|"),
								                        #"Access Point" = Vacio(AP),
								                        #"AP Código" = APCodigo,
								                        Created = CreatedAt,
								                        #"Created Date" = Date.From(CreatedAt),
								                        #"Resolution Date" = Resolved,
								                        #"Resolution Date Only" = if Resolved = null then null else Date.From(Resolved),
								                        #"Resolution Hours" = if Resolved = null then null else Duration.TotalHours(Resolved - CreatedAt),
								                        #"JSM Respuesta Meta Horas" = Respuesta[Meta],
								                        #"JSM Respuesta Horas" = Respuesta[Transcurrido],
								                        #"JSM Respuesta Estado" = Respuesta[Estado],
								                        #"JSM Resolución Meta Horas" = Resolucion[Meta],
								                        #"JSM Resolución Horas" = Resolucion[Transcurrido],
								                        #"JSM Resolución Estado" = Resolucion[Estado],
								                        // Primera respuesta: fin del primer ciclo del SLA. Resolución: fin del último ciclo
								                        // (entrada a Resuelta) cuando el SLA ya terminó. Horas naturales desde la creación.
								                        #"Primera Respuesta" = Respuesta[PrimerFin],
								                        #"JSM Horas a Primera Respuesta" =
								                            if Respuesta[PrimerFin] = null then null
								                            else Duration.TotalHours(Respuesta[PrimerFin] - CreatedAt),
								                        #"Entrada a Resuelta" = Resolucion[UltimoFin],
								                        #"JSM Horas a Resolución" =
								                            if Resolucion[UltimoFin] = null then null
								                            else Duration.TotalHours(Resolucion[UltimoFin] - CreatedAt),
								                        #"Hora Creación" = Time.Hour(CreatedAt),
								                        #"Día Semana Num" = Date.DayOfWeek(CreatedAt, Day.Monday) + 1
								                    ]
								        ),
				
								    Tickets =
								        Table.FromRecords(
								            Rows,
								            type table [
								                Key = text,
								                #"Issue ID" = text,
								                Summary = nullable text,
								                Status = nullable text,
								                #"Status Category" = nullable text,
								                Assignee = text,
								                #"Técnicos Asignados" = nullable text,
								                #"Organización" = text,
								                #"Request Type" = text,
								                #"Tipo de Ticket" = text,
								                ISP = text,
								                #"Tipo de Incidente" = text,
								                Causas = text,
								                #"Causas Ruta" = nullable text,
								                #"Access Point" = text,
								                #"AP Código" = nullable text,
								                Created = datetime,
								                #"Created Date" = date,
								                #"Resolution Date" = nullable datetime,
								                #"Resolution Date Only" = nullable date,
								                #"Resolution Hours" = nullable number,
								                #"JSM Respuesta Meta Horas" = nullable number,
								                #"JSM Respuesta Horas" = nullable number,
								                #"JSM Respuesta Estado" = text,
								                #"JSM Resolución Meta Horas" = nullable number,
								                #"JSM Resolución Horas" = nullable number,
								                #"JSM Resolución Estado" = text,
								                #"Primera Respuesta" = nullable datetime,
								                #"JSM Horas a Primera Respuesta" = nullable number,
								                #"Entrada a Resuelta" = nullable datetime,
								                #"JSM Horas a Resolución" = nullable number,
								                #"Hora Creación" = Int64.Type,
								                #"Día Semana Num" = Int64.Type
								            ]
								        )
				
								in
								    Tickets

	annotation PBI_ResultType = Table


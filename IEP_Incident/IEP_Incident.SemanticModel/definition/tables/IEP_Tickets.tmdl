	column 'Tiempo N2' = VAR M = IEP_Tickets[Min N2] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))

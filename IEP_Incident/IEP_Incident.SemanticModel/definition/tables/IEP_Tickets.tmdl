		dataType: string
		isHidden
		lineageTag: d293a4b5-c6d7-48e9-80a0-b7c8d9eafb09
		summarizeBy: none
		sourceColumn: JSM Respuesta Estado

		annotation SummarizationSetBy = Automatic

	/// Meta del SLA "Tiempo hasta resolución" de JSM, en horas (15 h o 24 h según el ticket).
	column 'JSM Resolución Meta Horas'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: e3a4b5c6-d7e8-49fa-91b1-c8d9eafb0c1a
		summarizeBy: none
		sourceColumn: JSM Resolución Meta Horas

		annotation SummarizationSetBy = Automatic

	/// Tiempo transcurrido del SLA de resolución según JSM (respeta pausas y calendario del SLA).
	column 'JSM Resolución Horas'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: f4b5c6d7-e8f9-4a0b-a2c2-d9eafb0c1d2b
		summarizeBy: none
		sourceColumn: JSM Resolución Horas

		annotation SummarizationSetBy = Automatic

	/// Estado oficial del SLA según Jira: Cumplido / Incumplido / En curso / En riesgo (queda 25% o menos) / Pausado / Sin SLA.
	column 'JSM Resolución Estado'
		dataType: string
		isHidden
		lineageTag: 05c6d7e8-f90a-4b1c-b3d3-eafb0c1d2e3c
		summarizeBy: none
		sourceColumn: JSM Resolución Estado

		annotation SummarizationSetBy = Automatic

	column 'Jira Link' = "https://secureopsmx.atlassian.net/browse/" & IEP_Tickets[Key]
		dataType: string
		lineageTag: 16d7e8f9-0a1b-4c2d-84e4-fb0c1d2e3f4d
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Hora real de la primera respuesta (fin del primer ciclo del SLA de primera respuesta, según Jira).
	column 'Primera Respuesta'
		dataType: dateTime
		formatString: General Date
		lineageTag: a6b5a546-431e-443e-92e8-aac7a6ba91ba
		summarizeBy: none
		sourceColumn: Primera Respuesta

		annotation SummarizationSetBy = Automatic

	/// Horas NATURALES desde la creación hasta la primera respuesta (no es tiempo de SLA).
	column 'JSM Horas a Primera Respuesta'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: bc8139ac-c3e9-48e5-bf0e-39479dd07cf2
		summarizeBy: none
		sourceColumn: JSM Horas a Primera Respuesta

		annotation SummarizationSetBy = Automatic

	/// Hora en que el ticket entró a Resuelta (fin del SLA de resolución, según Jira).
	column 'Entrada a Resuelta'
		dataType: dateTime
		formatString: General Date
		lineageTag: 6b6836cc-1001-4027-af72-a17580d7d6c2
		summarizeBy: none
		sourceColumn: Entrada a Resuelta

		annotation SummarizationSetBy = Automatic

	/// Horas NATURALES desde la creación hasta la entrada a Resuelta (no es tiempo de SLA).
	column 'JSM Horas a Resolución'
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: 788fdfd8-bb10-4794-9a3a-4deea13428ae
		summarizeBy: none
		sourceColumn: JSM Horas a Resolución

		annotation SummarizationSetBy = Automatic

	/// Hora del día (0 a 23) en que se creó el ticket, hora de Mérida.
	column 'Hora Creación'
		dataType: int64
		formatString: 0
		lineageTag: 98b7f7d6-018f-439d-96b5-d31201bfd375
		summarizeBy: none
		sourceColumn: Hora Creación

		annotation SummarizationSetBy = Automatic

	/// 1 = lunes … 7 = domingo.
	column 'Día Semana Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b73b44cf-08f3-42f3-baa6-b073ab615951
		summarizeBy: none
		sourceColumn: Día Semana Num

		annotation SummarizationSetBy = Automatic

	/// Día de la semana en que se creó el ticket.
	column 'Día Semana' = SWITCH(IEP_Tickets[Día Semana Num], 1, "Lunes", 2, "Martes", 3, "Miércoles", 4, "Jueves", 5, "Viernes", 6, "Sábado", "Domingo")
		dataType: string
		lineageTag: 49833183-df0c-4231-b20b-aebe3c2e8275
		summarizeBy: none
		sortByColumn: 'Día Semana Num'

		annotation SummarizationSetBy = Automatic

	/// Hora de creación como 00:00 … 23:00.
	column 'Hora Creación Texto' = FORMAT(IEP_Tickets[Hora Creación], "00") & ":00"
		dataType: string
		lineageTag: d8841528-dc4c-47b5-844b-ec82c81ec640
		summarizeBy: none
		sortByColumn: 'Hora Creación'

		annotation SummarizationSetBy = Automatic

	/// Minutos de SLA de resolución (15 h, calendario 24 h, sin pausas).
	column 'Tiempo SLA Min' = ROUND(IEP_Tickets[SLA Resolución Horas] * 60, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5e7a6ee3-cf60-4ff3-8aea-74bc01c31ea8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Minutos de la meta del SLA de resolución configurada en Jira.
	column 'Meta SLA Min' = ROUND(IEP_Tickets[SLA Resolución Meta Horas] * 60, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 51c76a73-07bd-4dc0-bcc1-1dfe7e94ea6c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Minutos de SLA por encima de la meta (solo tickets que excedieron el SLA de resolución).
	column 'Exceso SLA Min' = IF(IEP_Tickets[SLA Resolución Estado] = "Incumplido" && NOT ISBLANK(IEP_Tickets[Tiempo SLA Min]) && NOT ISBLANK(IEP_Tickets[Meta SLA Min]), MAX(0, IEP_Tickets[Tiempo SLA Min] - IEP_Tickets[Meta SLA Min]))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fb2d4674-3c25-443e-868f-c9061364f86a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Tiempo de resolución contabilizado por el SLA (estados activos, sin pausas; no es tiempo natural).
	column 'Tiempo SLA Resolución' = VAR M = IEP_Tickets[Tiempo SLA Min] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		dataType: string
		lineageTag: 3d31c36e-e3ea-4edd-a700-554892d1c3d3
		summarizeBy: none
		sortByColumn: 'Tiempo SLA Min'

		annotation SummarizationSetBy = Automatic

	/// Meta del SLA de resolución: 15 h.
	column 'Meta SLA Resolución' = VAR M = IEP_Tickets[Meta SLA Min] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		dataType: string
		lineageTag: 130f3e79-4199-433f-9d3a-b6a21d0b0fae
		summarizeBy: none
		sortByColumn: 'Meta SLA Min'

		annotation SummarizationSetBy = Automatic

	/// Tiempo de SLA por encima de la meta.
	column 'Exceso SLA' = VAR M = IEP_Tickets[Exceso SLA Min] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		dataType: string
		lineageTag: 2f2bf3d7-f989-4214-a72e-8a912c1b03f9
		summarizeBy: none
		sortByColumn: 'Exceso SLA Min'

		annotation SummarizationSetBy = Automatic

	/// Situación del ticket frente al SLA de resolución: dentro o fuera de SLA, resuelto o pendiente.
	column 'Situación SLA' = VAR Est = IEP_Tickets[SLA Resolución Estado] VAR Resuelto = NOT ISBLANK(IEP_Tickets[Fecha Resuelta]) RETURN SWITCH(TRUE(), Est = "Incumplido" && Resuelto, "Resuelto fuera de SLA", Est = "Incumplido", "Pendiente · fuera de SLA", Est = "Cumplido", "Resuelto en SLA", Est = "Pausado", "Pendiente · en pausa", "Pendiente · en SLA")
		dataType: string
		lineageTag: 7e1e4f97-e928-4bbe-a725-df981ebe2c96
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Meta del SLA de primera respuesta para todos los Incidente IEP: 30 min (calendario 24 h).
	column 'SLA Respuesta Meta Horas' = 0.5
		dataType: double
		formatString: #,##0.00
		lineageTag: 6e909948-b2fe-4480-824f-d8d8b295f947
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Meta del SLA de resolución para todos los Incidente IEP: 15 h (calendario 24 h).
	column 'SLA Resolución Meta Horas' = 15
		dataType: double
		formatString: #,##0.00
		lineageTag: 1bce2f30-38f0-4cd4-9318-e923ede61e78
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Hora del primer cambio de estado después de crear el ticket (se usa como primera respuesta si Jira no la tiene).
	column 'Primer Cambio de Estado' = MINX(FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Visita] > 1), FactStatusHistory[Inicio])
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 81c9b292-5663-4c16-9bb5-36020dcdc3e1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Primera entrada al estado Resuelta según el historial.
	column 'Entrada a Resuelta Historial' = MINX(FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Estado] = "Resuelta"), FactStatusHistory[Inicio])
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 31c7c866-5dc4-4dde-a84d-21fce5bbc868
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Horas naturales hasta la primera respuesta: dato de Jira si existe; si no, el primer cambio de estado.
	column 'Horas a Primera Respuesta' =
			VAR Jsm = IEP_Tickets[JSM Horas a Primera Respuesta]
			VAR Cambio = IEP_Tickets[Primer Cambio de Estado]
			RETURN IF(NOT ISBLANK(Jsm), Jsm, IF(NOT ISBLANK(Cambio), DATEDIFF(IEP_Tickets[Created], Cambio, MINUTE) / 60))
		dataType: double
		formatString: #,##0.00
		lineageTag: a715acc5-f04b-47fd-aa4e-a69f50dc1638
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Horas naturales de la creación a la fecha Resolved.
	column 'Horas a Resolución' =
			VAR Entrada = IEP_Tickets[Fecha Resuelta]
			RETURN IF(NOT ISBLANK(Entrada), DATEDIFF(IEP_Tickets[Created], Entrada, MINUTE) / 60)
		dataType: double
		formatString: #,##0.00
		lineageTag: d7100cb5-c7fb-4e18-8b7b-0386184a63cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Tiempo del SLA de primera respuesta (calendario 24 h). Si aún no hay respuesta, corre hasta el último refresh.
	column 'SLA Respuesta Horas' =
			VAR H = IEP_Tickets[Horas a Primera Respuesta]
			RETURN IF(NOT ISBLANK(H), H, DATEDIFF(IEP_Tickets[Created], (UTCNOW() - TIME(6, 0, 0)), MINUTE) / 60)
		dataType: double
		formatString: #,##0.00
		lineageTag: 131d07ab-7ecd-421a-b104-d38464b64593
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Tiempo del SLA de resolución (calendario 24 h): de la creación a la fecha Resolved (o al último refresh si sigue abierto), menos el tiempo en pausa (Esperando por el cliente, Planta externa y Cerrada).
	column 'SLA Resolución Horas' =
			VAR Fin = COALESCE(IEP_Tickets[Fecha Resuelta], (UTCNOW() - TIME(6, 0, 0)))
			VAR Total = DATEDIFF(IEP_Tickets[Created], Fin, MINUTE) / 60
			RETURN MAX(0, Total - IEP_Tickets[Horas en Pausa])
		dataType: double
		formatString: #,##0.00
		lineageTag: b35e3da8-ed7c-412b-83c3-37e2402b31ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Estado del SLA de primera respuesta con la meta de 30 min.
	column 'SLA Respuesta Estado' =
			VAR H = IEP_Tickets[SLA Respuesta Horas]
			VAR Respondido = NOT ISBLANK(IEP_Tickets[Horas a Primera Respuesta])
			RETURN
			    SWITCH(TRUE(),
			        H > IEP_Tickets[SLA Respuesta Meta Horas], "Incumplido",
			        Respondido, "Cumplido",
			        H >= IEP_Tickets[SLA Respuesta Meta Horas] * 0.75, "En riesgo",
			        "En curso")
		dataType: string
		lineageTag: 42ae1479-425a-4b8d-a910-44550c624d1a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Estado del SLA de resolución con la meta de 15 h: Cumplido, Incumplido, En curso, En riesgo (75% o más) o Pausado.
	column 'SLA Resolución Estado' =
			VAR H = IEP_Tickets[SLA Resolución Horas]
			VAR Meta = IEP_Tickets[SLA Resolución Meta Horas]
			VAR Resuelto = NOT ISBLANK(IEP_Tickets[Fecha Resuelta])
			VAR EnPausa = IEP_Tickets[Status] IN {"Esperando por el cliente", "Planta externa", "Cerrada"}
			RETURN
			    SWITCH(TRUE(),
			        H > Meta, "Incumplido",
			        Resuelto, "Cumplido",
			        EnPausa, "Pausado",
			        H >= Meta * 0.75, "En riesgo",
			        "En curso")
		dataType: string
		lineageTag: 76495ad6-a8dc-4656-87e4-c603786daca8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Minutos de vida del ticket: de la creación a la fecha Resolved (o al último refresh si sigue abierto).
	column 'Vida Total Min' = DATEDIFF(IEP_Tickets[Created], COALESCE(IEP_Tickets[Fecha Resuelta], (UTCNOW() - TIME(6, 0, 0))), MINUTE)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cf2b3890-3a10-4c2a-be88-5e05ce16c1a6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Vida total del ticket en tiempo natural (sin descontar pausas): de la creación a la fecha Resolved, o hasta hoy si sigue abierto.
	column 'Vida Total' = VAR M = IEP_Tickets[Vida Total Min] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		dataType: string
		lineageTag: 70062547-8d12-4fbe-99c4-ad5e13157f69
		summarizeBy: none
		sortByColumn: 'Vida Total Min'

		annotation SummarizationSetBy = Automatic

	/// Indica si el ticket estuvo al menos una vez en el estado Planta externa (según el historial de estados).
	column 'Planta Externa' = IF(ISEMPTY(FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Estado] = "Planta externa")), "No pasó por Planta externa", "Pasó por Planta externa")
		dataType: string
		lineageTag: 78e5e595-f4cd-4a37-9223-123fe89c763f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Fecha y hora de resolución del ticket: campo Resolved de Jira; si un ticket en Resuelta no lo tiene, la entrada a Resuelta. Todas las medidas de resolución y de SLA usan esta fecha.
	column 'Fecha Resuelta' = COALESCE(IEP_Tickets[Resolution Date], IEP_Tickets[Entrada a Resuelta Historial], IEP_Tickets[Entrada a Resuelta])
		dataType: dateTime
		formatString: General Date
		lineageTag: 2de9fa15-69ba-4339-8768-3870c685e8c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Día de resolución (Resolved) para contar los resueltos por periodo.
	column 'Fecha Resuelta Día' = IF(ISBLANK(IEP_Tickets[Fecha Resuelta]), BLANK(), DATE(YEAR(IEP_Tickets[Fecha Resuelta]), MONTH(IEP_Tickets[Fecha Resuelta]), DAY(IEP_Tickets[Fecha Resuelta])))
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 802eeef6-712e-4a4f-a790-2e31b56ea6eb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Horas en pausa del SLA de resolución (Esperando por el cliente, Planta externa y Cerrada) hasta la fecha Resolved.
	column 'Horas en Pausa' =
			VAR Fin = COALESCE(IEP_Tickets[Fecha Resuelta], (UTCNOW() - TIME(6, 0, 0)))
			RETURN
			    SUMX(
			        FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Estado] IN {"Esperando por el cliente", "Planta externa", "Cerrada"} && FactStatusHistory[Inicio] < Fin),
			        VAR FinTramo = IF(FactStatusHistory[Fin] < Fin, FactStatusHistory[Fin], Fin)
			        RETURN DATEDIFF(FactStatusHistory[Inicio], FinTramo, MINUTE) / 60
			    ) + 0
		dataType: double
		isHidden
		formatString: #,##0.00
		lineageTag: bfdddec8-4711-44f6-a69d-f580b6a401cf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Minutos en pausa del SLA de resolución.
	column 'Tiempo en Pausa Min' = ROUND(IEP_Tickets[Horas en Pausa] * 60, 0)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c773e5a1-93d3-48c2-bcdb-08e15f260633
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Tiempo en pausa del SLA de resolución, en formato legible.
	column 'Tiempo en Pausa' = VAR M = IEP_Tickets[Tiempo en Pausa Min] VAR D = INT(M / 1440) VAR H = INT(MOD(M, 1440) / 60) VAR Mi = MOD(M, 60) RETURN IF(ISBLANK(M), BLANK(), IF(D > 0, D & IF(D = 1, " día ", " días ") & H & " h " & FORMAT(Mi, "00") & " min", IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")))
		dataType: string
		lineageTag: 1194019d-32a0-434d-8eb2-8cb05af0452c
		summarizeBy: none
		sortByColumn: 'Tiempo en Pausa Min'

		annotation SummarizationSetBy = Automatic

	/// Tiempo total que el ticket pasó en cada estado antes de resolverse (todas las visitas sumadas), en el orden del flujo.
	column 'Tiempo por Estado' =
			VAR Tramos = FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Es Estado Final] = FALSE())
			VAR PorEstado =
			    GROUPBY(Tramos, FactStatusHistory[Estado], FactStatusHistory[Orden Estado], "Min", SUMX(CURRENTGROUP(), FactStatusHistory[Horas]) * 60)
			RETURN
			    CONCATENATEX(
			        PorEstado,
			        VAR M = ROUND([Min], 0)
			        VAR D = INT(M / 1440)
			        VAR H = INT(MOD(M, 1440) / 60)
			        VAR Mi = MOD(M, 60)
			        RETURN
			            FactStatusHistory[Estado] & ": "
			                & IF(D > 0, D & " d " & H & " h " & FORMAT(Mi, "00") & " min",
			                    IF(H > 0, H & " h " & FORMAT(Mi, "00") & " min", Mi & " min")),
			        " · ",
			        FactStatusHistory[Orden Estado], ASC
			    )
		dataType: string
		lineageTag: 523810d5-1e55-4f6e-95c3-375399347e40
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Minutos en Nueva solicitud hasta la fecha Resolved.
	column 'Min Nueva solicitud' =
			VAR Fin = COALESCE(IEP_Tickets[Fecha Resuelta], (UTCNOW() - TIME(6, 0, 0)))
			RETURN
			    SUMX(
			        FILTER(RELATEDTABLE(FactStatusHistory), FactStatusHistory[Estado] = "Nueva solicitud" && FactStatusHistory[Inicio] < Fin),
			        VAR FinTramo = IF(FactStatusHistory[Fin] < Fin, FactStatusHistory[Fin], Fin)
			        RETURN DATEDIFF(FactStatusHistory[Inicio], FinTramo, MINUTE)
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c31406ae-18dd-424d-bb5f-4f485288f8dd

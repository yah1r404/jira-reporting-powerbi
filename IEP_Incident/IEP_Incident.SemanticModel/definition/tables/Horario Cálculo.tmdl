	column Horario
		dataType: string
		lineageTag: 2438e5ac-4bed-473f-a0c1-b0dcc138b6d1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Horario]
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	column Clave
		dataType: string
		isHidden
		lineageTag: 69615729-8a4d-4544-816c-c77fd409f519
		summarizeBy: none
		isNameInferred
		sourceColumn: [Clave]

		annotation SummarizationSetBy = Automatic

	column Orden

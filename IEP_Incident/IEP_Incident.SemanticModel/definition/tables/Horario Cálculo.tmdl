		summarizeBy: none
		isNameInferred
		sourceColumn: [Orden]

		annotation SummarizationSetBy = Automatic

	partition 'Horario Cálculo' = calculated
		mode: import
		source =
				DATATABLE(
				    "Horario", STRING,
				    "Clave", STRING,
				    "Orden", INTEGER,
